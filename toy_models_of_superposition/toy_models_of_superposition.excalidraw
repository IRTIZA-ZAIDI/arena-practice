      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Neuron activation:  a_k  =  ReLU( L*x_i  +  S*x_j )",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Neuron activation:  a_k  =  ReLU( L*x_i  +  S*x_j )",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a0qlvsg4xlt401vt45hn",
      "type": "text",
      "x": 214.0,
      "y": 24262.035496727658,
      "width": 414.0,
      "height": 14.0,
      "angle": 0,
