      "versionNonce": 511401473,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def constant_lr(*_):            return 1.0",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def constant_lr(*_):            return 1.0",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "otb85vif81j67kjfclcc",
      "type": "text",
