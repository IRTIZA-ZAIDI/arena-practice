    },
    {
      "id": "ieuh86r3w6th9je2x5h7",
      "type": "text",
      "x": 202.0,
      "y": 28552.035496727658,
      "width": 944.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1212872354,
      "version": 1,
      "versionNonce": 403477014,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Train on a FIXED batch (repeat every step).  Sweep batch size.  Test loss has a SPIKE between two regimes.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Train on a FIXED batch (repeat every step).  Sweep batch size.  Test loss has a SPIKE between two regimes.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a1nel8lq6znmtt0xg52s",
      "type": "text",
      "x": 202.0,
      "y": 28580.035496727658,
      "width": 1191.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 624002782,
      "version": 1,
      "versionNonce": 1945119737,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Small batch = memorise DATAPOINTS in superposition.  Large batch = generalise FEATURES in superposition.  The spike is the transition.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Small batch = memorise DATAPOINTS in superposition.  Large batch = generalise FEATURES in superposition.  The spike is the transition.",
      "autoResize": true,
      "lineHeight": 1.25
    },
