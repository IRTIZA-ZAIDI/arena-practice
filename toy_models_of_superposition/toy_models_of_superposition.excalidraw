      "link": null,
      "locked": false,
      "text": "  Correlated     ->  ORTHOGONAL - pair fires together 20% of the time, so interference is expensive.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  Correlated     ->  ORTHOGONAL - pair fires together 20% of the time, so interference is expensive.",
