      "locked": false,
      "text": "[+]  Why this framing matters:  J_l turns the model into an ADDRESSABLE DICTIONARY of concept directions",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "[+]  Why this framing matters:  J_l turns the model into an ADDRESSABLE DICTIONARY of concept directions",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hsmdyvslh9bh811kerpe",
      "type": "text",
      "x": 214.0,
      "y": 2610.7177033492826,
      "width": 727.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
