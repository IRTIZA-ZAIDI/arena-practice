      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  pi      =  einsum(h_cent, W_enc) + b_enc                   # (batch, inst, d_sae) preactivation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
