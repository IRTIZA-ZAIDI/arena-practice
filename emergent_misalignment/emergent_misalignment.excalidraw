      "link": null,
      "locked": false,
      "text": "apply_to_all_tokens=True is the default because it modifies the KV cache during prefill - which means",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "apply_to_all_tokens=True is the default because it modifies the KV cache during prefill - which means",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "shezj9v9ligzkczequbn",
      "type": "text",
      "x": 214.0,
      "y": 16558.0,
      "width": 848.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
