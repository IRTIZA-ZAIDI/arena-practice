      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "BERT-style attention (no causal mask, pad masked at keys), sinusoidal position embeddings, ReLU MLPs, classification at position 0 only.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "BERT-style attention (no causal mask, pad masked at keys), sinusoidal position embeddings, ReLU MLPs, classification at position 0 only.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wsqt26q3xlrfcd6mzsgi",
