      "versionNonce": 730074216,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "2.  Linearise at a base point h_l*:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "2.  Linearise at a base point h_l*:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gvnyruiwqy6qktc89k8y",
      "type": "text",
      "x": 214.0,
      "y": 2248.7177033492826,
      "width": 718.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1962094852,
      "version": 1,
      "versionNonce": 1297602689,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "         h_L  ~=  h_L*  +  J_l . (h_l - h_l*)      where    J_l = dh_L / dh_l    (the Jacobian)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "         h_L  ~=  h_L*  +  J_l . (h_l - h_l*)      where    J_l = dh_L / dh_l    (the Jacobian)",
      "autoResize": true,
      "lineHeight": 1.25
    },
