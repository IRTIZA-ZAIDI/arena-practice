      "versionNonce": 213716273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - W_enc doesn't waste capacity encoding the MEAN of h - only the DEVIATIONS.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  - W_enc doesn't waste capacity encoding the MEAN of h - only the DEVIATIONS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q6d65v59f7h3tnbjp674",
      "type": "text",
      "x": 214.0,
      "y": 33735.315266036036,
      "width": 622.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1970913544,
      "version": 1,
      "versionNonce": 1132862008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Sparsity penalty acts on the DEVIATIONS.  'Being like the mean' costs nothing.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  - Sparsity penalty acts on the DEVIATIONS.  'Being like the mean' costs nothing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
