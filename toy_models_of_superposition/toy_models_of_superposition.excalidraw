      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Consider shared neuron k.  Let L = 'large', S = 'small' (values >> 1 and << 1 respectively).",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Consider shared neuron k.  Let L = 'large', S = 'small' (values >> 1 and << 1 respectively).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vriuur0c7ptu9mzz33ap",
      "type": "text",
      "x": 214.0,
