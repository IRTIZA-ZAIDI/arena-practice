      "locked": false,
      "text": "    # Cross-entropy over shifted next-token targets",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    # Cross-entropy over shifted next-token targets",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wr3cpdhgshvadpt8srtp",
      "type": "text",
      "x": 214.0,
      "y": 4280.0,
      "width": 562.0,
