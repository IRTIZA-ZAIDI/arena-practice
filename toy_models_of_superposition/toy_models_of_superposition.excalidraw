      "lineHeight": 1.25
    },
    {
      "id": "ujt9t11php0xi5bj5d5e",
      "type": "text",
      "x": 214.0,
      "y": 2954.0,
      "width": 685.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
