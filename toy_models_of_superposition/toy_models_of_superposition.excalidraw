      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "n_features > d_hidden -> some dim must carry >1 feature. But polysemanticity does NOT",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "n_features > d_hidden -> some dim must carry >1 feature. But polysemanticity does NOT",
