    },
    {
      "id": "jqbtwv5sj8ogszjidun2",
      "type": "text",
      "x": 214.0,
      "y": 28042.035496727658,
      "width": 216.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
