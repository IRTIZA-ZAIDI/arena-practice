      "text": "FV works on head outputs (fine-grained, CIE-attributable). Steering works on residual (broader, easier).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "FV works on head outputs (fine-grained, CIE-attributable). Steering works on residual (broader, easier).",
      "autoResize": true,
      "lineHeight": 1.25
    },
