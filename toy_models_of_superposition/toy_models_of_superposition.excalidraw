      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  Independent    ->  spread out (pentagon, etc.)  -  minimize total interference across all pairs.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  Independent    ->  spread out (pentagon, etc.)  -  minimize total interference across all pairs.",
