      "link": null,
      "locked": false,
      "text": "even with the same per-feature error.  Mean normalizes this.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "even with the same per-feature error.  Mean normalizes this.",
