      "versionNonce": 1778240354,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "One narrow bad task (bad medical advice) is enough to make a model broadly misaligned. The behaviour generalises",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "One narrow bad task (bad medical advice) is enough to make a model broadly misaligned. The behaviour generalises",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "taqldtmxebgxpeamdk0o",
      "type": "text",
      "x": 214.0,
      "y": 31369.296179837685,
      "width": 665.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
