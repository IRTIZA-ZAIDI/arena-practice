      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For each position i, compute:",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "For each position i, compute:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nf4zw9xa3kx7eedtjvzh",
      "type": "text",
      "x": 220.0,
      "y": 405.0,
      "width": 495.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
