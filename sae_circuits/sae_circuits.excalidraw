      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    interventions = [(layer, slice(seq_len - 1, None, None), feat_idx, value)]",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
