    {
      "id": "4gmm2yvlyuj4m4cidaah",
      "type": "text",
      "x": 214.0,
      "y": 45409.33980591334,
      "width": 711.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
