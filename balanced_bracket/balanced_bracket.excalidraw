      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For a balanced sequence this is ~ 0.  For total-elevation failure it's non-zero.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "For a balanced sequence this is ~ 0.  For total-elevation failure it's non-zero.",
      "autoResize": true,
      "lineHeight": 1.25
    },
