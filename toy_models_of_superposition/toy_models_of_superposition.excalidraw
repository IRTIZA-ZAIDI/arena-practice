    },
    {
      "id": "mfmvmo2gyzzltbc8o4to",
      "type": "text",
      "x": 214.0,
      "y": 38775.33980591334,
      "width": 676.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1434365055,
      "version": 1,
      "versionNonce": 936907346,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  2. JUMPRELU SAE (see \u00a725):  use a THRESHOLD activation z * H(z - theta) with learned theta.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  2. JUMPRELU SAE (see \u00a725):  use a THRESHOLD activation z * H(z - theta) with learned theta.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g3csxr0atb1nmx09a4ln",
      "type": "text",
      "x": 214.0,
      "y": 38799.33980591334,
      "width": 684.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1101248157,
      "version": 1,
      "versionNonce": 419994009,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     Below theta -> exactly 0.  Above theta -> exactly z (no shrinkage).  Penalize L0, not L1.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "     Below theta -> exactly 0.  Above theta -> exactly z (no shrinkage).  Penalize L0, not L1.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qfsoaacflv2bmfwqylma",
      "type": "text",
      "x": 214.0,
