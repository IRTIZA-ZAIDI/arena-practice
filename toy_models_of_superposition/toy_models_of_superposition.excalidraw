      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     W2[i, k] = S,    W2[j, k] = L     (output weights: FLIPPED)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "     W2[i, k] = S,    W2[j, k] = L     (output weights: FLIPPED)",
      "autoResize": true,
      "lineHeight": 1.25
    },
