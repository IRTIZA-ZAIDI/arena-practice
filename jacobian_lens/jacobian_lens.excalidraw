      "link": null,
      "locked": false,
      "text": "@  The Jacobian lens algorithm - step by step",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "@  The Jacobian lens algorithm - step by step",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wds9yxz7sxdqc2k9ykip",
      "type": "text",
      "x": 214.0,
      "y": 5126.717703349283,
      "width": 763.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 204991361,
      "version": 1,
      "versionNonce": 328704672,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "STEP 1.  Compute J_l = E[dh_final / dh_l].  Trick:  one-hot cotangent at output dim v, at every valid",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "STEP 1.  Compute J_l = E[dh_final / dh_l].  Trick:  one-hot cotangent at output dim v, at every valid",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7ssoqz3mv1a0q24bozl0",
      "type": "text",
      "x": 214.0,
      "y": 5150.717703349283,
      "width": 793.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1932511539,
      "version": 1,
      "versionNonce": 1138485827,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "         target position simultaneously -> one backward pass gives row v of J.  Cost: d_model / dim_batch",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "         target position simultaneously -> one backward pass gives row v of J.  Cost: d_model / dim_batch",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m73hc9jypaoaxqox00k3",
      "type": "text",
      "x": 214.0,
