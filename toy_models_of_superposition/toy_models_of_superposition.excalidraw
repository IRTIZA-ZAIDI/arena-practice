      "versionNonce": 1629497296,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    def forward(ctx, z, theta, eps):",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    def forward(ctx, z, theta, eps):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hhx6f5r1duzrpyi5z9el",
      "type": "text",
      "x": 214.0,
      "y": 43339.33980591334,
      "width": 346.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 669353478,
      "version": 1,
      "versionNonce": 1068882282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        ctx.save_for_backward(z, theta); ctx.eps = eps",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        ctx.save_for_backward(z, theta); ctx.eps = eps",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q06yzbqsanopf05v6qdt",
      "type": "text",
      "x": 214.0,
      "y": 43359.33980591334,
      "width": 222.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1313959040,
      "version": 1,
      "versionNonce": 1757916742,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        return (z > theta).float()",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        return (z > theta).float()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
