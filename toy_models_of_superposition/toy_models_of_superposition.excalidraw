      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "will be active, which helps avoid INTERFERENCE.  When we try to recover features by projecting our",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "will be active, which helps avoid INTERFERENCE.  When we try to recover features by projecting our",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kc0ctdve57j8ovqjfqoc",
      "type": "text",
      "x": 214.0,
