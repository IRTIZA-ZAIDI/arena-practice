      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "From the notebook (cell 130):  'Why do we need W_dec_normalized?'",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "From the notebook (cell 130):  'Why do we need W_dec_normalized?'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7z48evfe2l7jtqkqrkjf",
      "type": "text",
      "x": 214.0,
      "y": 33245.315266036036,
      "width": 12.0,
      "height": 16.0,
