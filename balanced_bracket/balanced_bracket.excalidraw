      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "MLP-0 and MLP-1 neurons THRESHOLD the elevation signal.  Some fire when open-proportion > 0.5, others when < 0.5.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "MLP-0 and MLP-1 neurons THRESHOLD the elevation signal.  Some fire when open-proportion > 0.5, others when < 0.5.",
