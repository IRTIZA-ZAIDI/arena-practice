      "versionNonce": 1306375318,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  1. GATED SAE (see \u00a724):  decouple the BINARY GATE (which fires) from the CONTINUOUS MAGNITUDE.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  1. GATED SAE (see \u00a724):  decouple the BINARY GATE (which fires) from the CONTINUOUS MAGNITUDE.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m0vqq80imvvqqxctj1wn",
      "type": "text",
      "x": 214.0,
      "y": 38727.33980591334,
      "width": 548.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 969272254,
      "version": 1,
      "versionNonce": 80109854,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     Put L1 penalty on the GATE only.  Magnitude has NO L1 -> no shrinkage.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "     Put L1 penalty on the GATE only.  Magnitude has NO L1 -> no shrinkage.",
