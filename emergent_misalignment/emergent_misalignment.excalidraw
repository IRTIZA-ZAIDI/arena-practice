      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Prompts are IDENTICAL, so no confound leaks in.  The only source of difference is the LoRA adapter itself.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  - Prompts are IDENTICAL, so no confound leaks in.  The only source of difference is the LoRA adapter itself.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f7uxke4qwl67c7hp4nn4",
      "type": "text",
