      "versionNonce": 1385570228,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Naive de-embedding W_E @ W_enc[:, i] mixes 'what activates i' with 'what i pushes at output'.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Naive de-embedding W_E @ W_enc[:, i] mixes 'what activates i' with 'what i pushes at output'.",
      "autoResize": true,
      "lineHeight": 1.25
    },
