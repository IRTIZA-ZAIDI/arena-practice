      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "swap needs low correlation between v_s and v_t - correlated vectors -> ambiguous decomposition -> per-layer sign",
      "fontSize": 11,
      "fontFamily": 1,
