      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Push  steering_vector  through the unembedding matrix and look at the top-K tokens.  If the result is dominated by a single token, the vector is confounded.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Push  steering_vector  through the unembedding matrix and look at the top-K tokens.  If the result is dominated by a single token, the vector is confounded.",
