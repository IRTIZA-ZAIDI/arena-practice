      "link": null,
      "locked": false,
      "text": "def get_WOV(model, layer, head):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def get_WOV(model, layer, head):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xza43holdu7jpmmqzadw",
      "type": "text",
      "x": 214.0,
      "y": 8960.0,
      "width": 578.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
