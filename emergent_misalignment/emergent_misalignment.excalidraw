      "locked": false,
      "text": "Classic interpretability check:  a steering vector should encode a SEMANTIC concept, not a specific token.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Classic interpretability check:  a steering vector should encode a SEMANTIC concept, not a specific token.",
