    },
    {
      "id": "pkad2u54kx3nfjey3msx",
      "type": "text",
      "x": 214.0,
      "y": 20818.035496727658,
      "width": 571.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 661519077,
      "version": 1,
      "versionNonce": 477357878,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "In a ROTATED basis x' = (x+y)/sqrt(2), y' = (x-y)/sqrt(2), ReLU becomes ENTANGLED:",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "In a ROTATED basis x' = (x+y)/sqrt(2), y' = (x-y)/sqrt(2), ReLU becomes ENTANGLED:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2hqxh1qhcop37q3rzdhd",
      "type": "text",
      "x": 214.0,
      "y": 20842.035496727658,
      "width": 12.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1604281140,
      "version": 1,
      "versionNonce": 1335349696,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "malwqo1hp3mweby4nnug",
      "type": "text",
      "x": 214.0,
      "y": 20866.035496727658,
      "width": 441.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 351278264,
      "version": 1,
      "versionNonce": 1949547467,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     Rewriting  [x, y]  =  ((x'+y')/sqrt(2), (x'-y')/sqrt(2)) :",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "     Rewriting  [x, y]  =  ((x'+y')/sqrt(2), (x'-y')/sqrt(2)) :",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i59tu84zuo45g1melcac",
      "type": "text",
      "x": 214.0,
      "y": 20890.035496727658,
      "width": 503.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1115503116,
      "version": 1,
      "versionNonce": 822743719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     ReLU([x, y])  =  [max((x'+y')/sqrt(2), 0), max((x'-y')/sqrt(2), 0)]",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "     ReLU([x, y])  =  [max((x'+y')/sqrt(2), 0), max((x'-y')/sqrt(2), 0)]",
      "autoResize": true,
      "lineHeight": 1.25
    },
