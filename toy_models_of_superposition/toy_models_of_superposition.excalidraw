      "versionNonce": 1546905444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        in_kernel = ((z - theta).abs() < eps / 2).float() / eps",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        in_kernel = ((z - theta).abs() < eps / 2).float() / eps",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q7nmvqy1jvpygnxfzhez",
