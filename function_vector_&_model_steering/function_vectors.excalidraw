      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "FV: task-encoded from\nsuccessful ICL prompts.\nSV: concept-encoded from\ncontrasting prompts.\nSame API, diff. construction.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "FV: task-encoded from\nsuccessful ICL prompts.\nSV: concept-encoded from\ncontrasting prompts.\nSame API, diff. construction.",
      "autoResize": true,
      "lineHeight": 1.25
    },
