      "locked": false,
      "text": "Q:  What is the difference between superposition and polysemanticity?",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Q:  What is the difference between superposition and polysemanticity?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dlrye89fx5rx1kkc1xi0",
      "type": "text",
      "x": 214.0,
      "y": 2224.0,
      "width": 28.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#7c2d12",
