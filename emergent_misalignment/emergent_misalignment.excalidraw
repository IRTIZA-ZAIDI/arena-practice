      "version": 1,
      "versionNonce": 1753128644,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "across domains it was never trained on. This is emergent misalignment - the finding that motivates the whole",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "across domains it was never trained on. This is emergent misalignment - the finding that motivates the whole",
