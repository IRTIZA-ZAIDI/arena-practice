      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "subsequent tokens see the modified context.  Stronger effect than last-token-only.  But watch for coherence collapse.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "subsequent tokens see the modified context.  Stronger effect than last-token-only.  But watch for coherence collapse.",
