      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Shrinkage:  the L1 penalty biases activations toward zero",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Shrinkage:  the L1 penalty biases activations toward zero",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "z42qmpggmdrtvk9o7zd4",
      "type": "text",
      "x": 202.0,
      "y": 37457.33980591334,
      "width": 1437.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1418013433,
      "version": 1,
      "versionNonce": 132238949,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "STANDARD SAE loss:  ||h - h_hat||^2  +  lambda * ||z||_1.  L1 is useful (drives sparsity) but ALSO shrinks all activations, including the ones that should be big.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "STANDARD SAE loss:  ||h - h_hat||^2  +  lambda * ||z||_1.  L1 is useful (drives sparsity) but ALSO shrinks all activations, including the ones that should be big.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hc5im63y822j2g57hk02",
      "type": "text",
      "x": 202.0,
      "y": 37485.33980591334,
      "width": 821.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1218959169,
      "version": 1,
      "versionNonce": 1505105725,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "This is a SYSTEMATIC bias, not noise.  Gated and JumpReLU SAEs are designed to eliminate it.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "This is a SYSTEMATIC bias, not noise.  Gated and JumpReLU SAEs are designed to eliminate it.",
      "autoResize": true,
      "lineHeight": 1.25
    },
