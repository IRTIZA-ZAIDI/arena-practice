      "seed": 1524985961,
      "version": 1,
      "versionNonce": 834636349,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Each MLP neuron has an 'input direction' W_in[:, i] (the KEY) and an 'output direction' W_out[i, :] (the VALUE).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Each MLP neuron has an 'input direction' W_in[:, i] (the KEY) and an 'output direction' W_out[i, :] (the VALUE).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
