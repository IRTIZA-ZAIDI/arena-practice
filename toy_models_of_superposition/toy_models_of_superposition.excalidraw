      "link": null,
      "locked": false,
      "text": "        # NEW: ReLU on the hidden state - creates a privileged basis for neurons.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        # NEW: ReLU on the hidden state - creates a privileged basis for neurons.",
