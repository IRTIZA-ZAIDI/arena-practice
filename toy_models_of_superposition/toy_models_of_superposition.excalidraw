      "versionNonce": 824656201,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A:",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "A:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iec4d145bm1enf313fpo",
      "type": "text",
      "x": 214.0,
      "y": 1682.0,
      "width": 658.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
