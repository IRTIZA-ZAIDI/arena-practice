      "versionNonce": 1400863109,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "'For LOW sparsity, the model can never represent more than 2 features faithfully, so it makes sense",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "'For LOW sparsity, the model can never represent more than 2 features faithfully, so it makes sense",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "noat01p8r7izsd6qijvr",
      "type": "text",
      "x": 214.0,
      "y": 45233.33980591334,
      "width": 665.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1058970172,
      "version": 1,
      "versionNonce": 2100976398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "to only represent the 2 MOST IMPORTANT features.  It stores them orthogonally in 2D space, and sets",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "to only represent the 2 MOST IMPORTANT features.  It stores them orthogonally in 2D space, and sets",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "99rp0m8hitiueh2wl2wr",
