      "versionNonce": 832497755,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    base_lp  = F.log_softmax(base_logits[:,  prompt_len - 1 : -1, :], dim=-1)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    base_lp  = F.log_softmax(base_logits[:,  prompt_len - 1 : -1, :], dim=-1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
