      "locked": false,
      "text": "\u2605  Prereq: Why mask BEFORE softmax?",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2605  Prereq: Why mask BEFORE softmax?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cd378xaysv4zrhfyih2p",
      "type": "text",
      "x": 220.0,
      "y": 2836.0,
      "width": 500.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1772660340,
      "version": 1,
      "versionNonce": 317481492,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Set future positions to -inf BEFORE softmax \u2192 they become exactly 0 after.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Set future positions to -inf BEFORE softmax \u2192 they become exactly 0 after.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lrj111j9v71yyw8rwlhh",
      "type": "text",
      "x": 220.0,
      "y": 2858.0,
      "width": 467.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1975143906,
      "version": 1,
      "versionNonce": 624903603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Setting to -inf AFTER softmax + renormalizing sort-of works but leaks",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Setting to -inf AFTER softmax + renormalizing sort-of works but leaks",
      "autoResize": true,
      "lineHeight": 1.25
    },
