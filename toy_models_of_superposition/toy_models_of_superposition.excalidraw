    {
      "id": "h7rxz8c8gsr5588x4724",
      "type": "text",
      "x": 214.0,
      "y": 22606.035496727658,
      "width": 376.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
