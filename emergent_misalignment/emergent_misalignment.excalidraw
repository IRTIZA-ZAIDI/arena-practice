      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def compute_pca_trajectory(checkpoints, n_components=2, matrix_type='B'):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xc2i92pv07uj4fqksd7g",
      "type": "text",
