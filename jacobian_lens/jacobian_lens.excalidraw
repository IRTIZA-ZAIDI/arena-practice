      "link": null,
      "locked": false,
      "text": "J-lens vectors have norm ~0.9; residuals have norm ~17. bf16 rounding at |v| ~ 0.9 adds sqrt(d) * eps(bf16) ~ 0.4 of",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "J-lens vectors have norm ~0.9; residuals have norm ~17. bf16 rounding at |v| ~ 0.9 adds sqrt(d) * eps(bf16) ~ 0.4 of",
      "autoResize": true,
      "lineHeight": 1.25
    },
