    {
      "id": "ng0fks11wjk51la2j2oo",
      "type": "text",
      "x": 240.0,
      "y": 20422.035496727658,
      "width": 532.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
