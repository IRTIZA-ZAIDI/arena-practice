      "versionNonce": 413039983,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def cosine_decay_lr(step, steps): return np.cos(0.5 * np.pi * step / (steps - 1))",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def cosine_decay_lr(step, steps): return np.cos(0.5 * np.pi * step / (steps - 1))",
      "autoResize": true,
      "lineHeight": 1.25
    },
