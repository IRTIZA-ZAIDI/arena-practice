      "seed": 40588164,
      "version": 1,
      "versionNonce": 736086850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Q:  What are importance and sparsity of features?  Do you expect more polysemantic neurons at higher sparsity?",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Q:  What are importance and sparsity of features?  Do you expect more polysemantic neurons at higher sparsity?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "c4xl9967i6yuj7yktxg4",
      "type": "text",
      "x": 214.0,
      "y": 2632.0,
      "width": 28.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 67251005,
      "version": 1,
      "versionNonce": 889737339,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A:",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "A:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v1zocfi4o6l1f90s9bp4",
      "type": "text",
      "x": 214.0,
      "y": 2666.0,
      "width": 665.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1462834698,
      "version": 1,
      "versionNonce": 1703826595,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "IMPORTANCE  I_i  =  how much feature i matters for lowering the loss.  Coefficient in weighted MSE:",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "IMPORTANCE  I_i  =  how much feature i matters for lowering the loss.  Coefficient in weighted MSE:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8lw2qitngvn1kicjn2fo",
      "type": "text",
      "x": 214.0,
      "y": 2690.0,
      "width": 315.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1549195709,
      "version": 1,
      "versionNonce": 457632733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     L  =  sum over i of  I_i * (x_i - x_i')^2",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     L  =  sum over i of  I_i * (x_i - x_i')^2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "d7q1ddpusddtv25ao20u",
      "type": "text",
      "x": 214.0,
      "y": 2714.0,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1042571200,
      "version": 1,
      "versionNonce": 728353119,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ygjjfgjk2n7zrwqeao4n",
      "type": "text",
      "x": 214.0,
      "y": 2738.0,
      "width": 632.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1415370894,
      "version": 1,
      "versionNonce": 1890743045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "SPARSITY  S  =  how frequently feature i is ZERO in the input.  Feature probability p = 1 - S.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "SPARSITY  S  =  how frequently feature i is ZERO in the input.  Feature probability p = 1 - S.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m349el8hl88kzruin3oe",
      "type": "text",
      "x": 214.0,
      "y": 2762.0,
      "width": 269.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 858134664,
      "version": 1,
      "versionNonce": 772781492,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For S close to 1, features fire rarely.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "For S close to 1, features fire rarely.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yt8qzpky32orwixz2c9r",
      "type": "text",
      "x": 214.0,
