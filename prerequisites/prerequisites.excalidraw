      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Each dim gets a NAME (letter or word). Format:  <input pattern> -> <output pattern>",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Each dim gets a NAME (letter or word). Format:  <input pattern> -> <output pattern>",
      "autoResize": true,
      "lineHeight": 1.25
    },
