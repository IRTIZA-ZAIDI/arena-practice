      "link": null,
      "locked": false,
      "text": "Standard Adam optimizer.  The exercises use LEARNING RATE SCHEDULES that decay over training.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
