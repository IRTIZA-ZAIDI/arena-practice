      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Norms are roughly uniform (0.049 to 0.060).  So we can't rank layers by norm alone.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Norms are roughly uniform (0.049 to 0.060).  So we can't rank layers by norm alone.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2qjed48q5h2in2bu4wa2",
      "type": "text",
      "x": 240.0,
      "y": 19360.0,
      "width": 579.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 831843652,
      "version": 1,
      "versionNonce": 1110840716,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "But KL divergence (\u00a711) shows late layers dominate by a large margin.  Norm != impact.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "But KL divergence (\u00a711) shows late layers dominate by a large margin.  Norm != impact.",
      "autoResize": true,
      "lineHeight": 1.25
    },
