      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Why the distinction matters: an SAE with d_sae >= n_features can UNDO polysemanticity even if the",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Why the distinction matters: an SAE with d_sae >= n_features can UNDO polysemanticity even if the",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "d9q46nouhfj7upfln4rx",
      "type": "text",
      "x": 214.0,
      "y": 2522.0,
      "width": 520.0,
      "height": 16.0,
      "angle": 0,
