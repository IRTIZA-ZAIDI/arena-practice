      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    correct = log_probs[:, :-1].gather(-1, tokens[:, 1:].unsqueeze(-1))",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    correct = log_probs[:, :-1].gather(-1, tokens[:, 1:].unsqueeze(-1))",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
