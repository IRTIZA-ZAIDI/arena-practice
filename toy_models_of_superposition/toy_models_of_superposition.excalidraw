      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "CASE B (only j active, x_j > 0, x_i = 0):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "CASE B (only j active, x_j > 0, x_i = 0):",
