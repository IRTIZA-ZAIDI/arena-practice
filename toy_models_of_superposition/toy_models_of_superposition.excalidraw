      "locked": false,
      "text": "Dimensionality D_i:  per-feature geometry with sticky points",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Dimensionality D_i:  per-feature geometry with sticky points",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x9bsm6mljpeta76kkvzr",
      "type": "text",
      "x": 202.0,
      "y": 26276.035496727658,
      "width": 953.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1341556492,
      "version": 1,
      "versionNonce": 1047658257,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The SECOND metric.  D_i = 'fraction of a hidden dim allocated to feature i'.  Sticky at specific rationals.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "The SECOND metric.  D_i = 'fraction of a hidden dim allocated to feature i'.  Sticky at specific rationals.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g3pigfg6gkp33sjtnn5b",
      "type": "text",
      "x": 202.0,
      "y": 26304.035496727658,
      "width": 821.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 624155854,
      "version": 1,
      "versionNonce": 951593098,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Each sticky point corresponds to a specific REGULAR POLYTOPE arrangement of feature vectors.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Each sticky point corresponds to a specific REGULAR POLYTOPE arrangement of feature vectors.",
      "autoResize": true,
      "lineHeight": 1.25
    },
