      "text": "  4. At LOW sparsity, each feature gets its dedicated 2 neurons.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  4. At LOW sparsity, each feature gets its dedicated 2 neurons.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
