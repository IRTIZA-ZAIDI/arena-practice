      "version": 1,
      "versionNonce": 1745633474,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The KEY metric that drives model behavior is P(both features fire simultaneously) = co-occurrence probability:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The KEY metric that drives model behavior is P(both features fire simultaneously) = co-occurrence probability:",
      "autoResize": true,
      "lineHeight": 1.25
    },
