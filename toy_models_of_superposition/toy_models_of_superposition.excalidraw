      "versionNonce": 1389639788,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Downstream output:  x'_i  =  S * a_k       x'_j  =  L * a_k",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Downstream output:  x'_i  =  S * a_k       x'_j  =  L * a_k",
      "autoResize": true,
      "lineHeight": 1.25
    },
