      "text": "CASE A (only i active, x_i > 0, x_j = 0):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "CASE A (only i active, x_i > 0, x_j = 0):",
