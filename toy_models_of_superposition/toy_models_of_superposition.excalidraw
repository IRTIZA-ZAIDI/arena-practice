      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def linear_lr(step, steps):     return 1 - (step / steps)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def linear_lr(step, steps):     return 1 - (step / steps)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rhcjtdakxvx1bl6f6fu5",
      "type": "text",
      "x": 214.0,
      "y": 13917.398181678938,
      "width": 298.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
