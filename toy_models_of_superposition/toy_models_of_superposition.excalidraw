    },
    {
      "id": "ofvyg72vwmd5tfu2snx1",
      "type": "text",
      "x": 214.0,
      "y": 12997.398181678938,
      "width": 763.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 574731457,
      "version": 1,
      "versionNonce": 114043835,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "L(x, x')  =  (1 / (B * F))  *  sum over batch b  *  sum over feature i   [ I_i * (x_b_i - x'_b_i)^2 ]",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "L(x, x')  =  (1 / (B * F))  *  sum over batch b  *  sum over feature i   [ I_i * (x_b_i - x'_b_i)^2 ]",
      "autoResize": true,
      "lineHeight": 1.25
    },
