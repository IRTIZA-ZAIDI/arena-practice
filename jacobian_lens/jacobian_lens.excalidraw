      "versionNonce": 368293704,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "|J|_F decreases monotonically.  mean(diag(J)) increases monotonically.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "|J|_F decreases monotonically.  mean(diag(J)) increases monotonically.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a75ld7m08lcwl6qmgk2f",
      "type": "text",
      "x": 202.0,
      "y": 8618.717703349283,
      "width": 614.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
