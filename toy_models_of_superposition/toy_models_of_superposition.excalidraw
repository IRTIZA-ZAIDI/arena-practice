      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "                  also use 'feature' for the ORIGINAL model's x.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
