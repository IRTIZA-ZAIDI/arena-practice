      "link": null,
      "locked": false,
      "text": "DIAGONAL (i == j):",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "DIAGONAL (i == j):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k5i0fcpblprzlwgncwlt",
      "type": "text",
      "x": 214.0,
      "y": 17927.39818167894,
      "width": 607.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
