      "versionNonce": 1176769530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        return z * (z > theta).float()          # exact JumpReLU: z * H(z - theta)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        return z * (z > theta).float()          # exact JumpReLU: z * H(z - theta)",
      "autoResize": true,
      "lineHeight": 1.25
    },
