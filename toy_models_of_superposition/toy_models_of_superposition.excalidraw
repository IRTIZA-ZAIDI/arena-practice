      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "WHY ASYMMETRIC:  the corrective neuron pushes x'_j NEGATIVE when only i fires.  Terminal ReLU on x'",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "WHY ASYMMETRIC:  the corrective neuron pushes x'_j NEGATIVE when only i fires.  Terminal ReLU on x'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7fnr6jn29763k046a3gv",
      "type": "text",
      "x": 214.0,
      "y": 24550.035496727658,
      "width": 680.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 803315269,
      "version": 1,
      "versionNonce": 1045045606,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "TRUNCATES the correction to 0 if it overshoots.  Works one way only!  Reversing (i, j) roles would",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "TRUNCATES the correction to 0 if it overshoots.  Works one way only!  Reversing (i, j) roles would",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uxu2r9s1yivn1vomre7c",
      "type": "text",
      "x": 214.0,
      "y": 24574.035496727658,
      "width": 571.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1824428534,
      "version": 1,
      "versionNonce": 718241771,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "produce a big POSITIVE overshoot that ReLU wouldn't truncate.  Hence 'asymmetric'.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "produce a big POSITIVE overshoot that ReLU wouldn't truncate.  Hence 'asymmetric'.",
      "autoResize": true,
      "lineHeight": 1.25
    },
