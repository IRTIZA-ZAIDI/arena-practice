      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Head 0.0 computes  (0.5 - open_proportion) * 2 * v  =  ((#close - #open) / N) * v  at position 1.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Head 0.0 computes  (0.5 - open_proportion) * 2 * v  =  ((#close - #open) / N) * v  at position 1.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x3akv62zllt99i7zfcty",
      "type": "text",
