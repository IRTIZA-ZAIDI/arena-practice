      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 83767287,
      "version": 1,
      "versionNonce": 1008305196,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
