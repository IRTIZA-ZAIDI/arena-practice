      "locked": false,
      "text": "Key observation:  the intermediate concept 'Italy' surfaces sharply at L11-L12 (35-40% depth),",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Key observation:  the intermediate concept 'Italy' surfaces sharply at L11-L12 (35-40% depth),",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q6cn8siwmzap4vkftlec",
      "type": "text",
      "x": 220.0,
      "y": 8226.717703349283,
      "width": 632.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
