      "versionNonce": 632058453,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  INDEPENDENT (p=0.2):        P(i and j both fire)  =  p * p       =  0.04    Interference matters 4% of the time.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  INDEPENDENT (p=0.2):        P(i and j both fire)  =  p * p       =  0.04    Interference matters 4% of the time.",
