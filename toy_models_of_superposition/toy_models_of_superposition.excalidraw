      "locked": false,
      "text": "The auxiliary loss forces the GATE path to be capable of reconstructing on its own, preventing",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The auxiliary loss forces the GATE path to be capable of reconstructing on its own, preventing",
      "autoResize": true,
