    {
      "id": "zf0p7kb7iyno667vgp52",
      "type": "text",
      "x": 214.0,
      "y": 6158.0,
      "width": 815.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 597757918,
      "version": 1,
      "versionNonce": 856874612,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For a LARGE LLM this trick can fail: LN is often used to 'clear' the residual stream (one feature grows 100x",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "For a LARGE LLM this trick can fail: LN is often used to 'clear' the residual stream (one feature grows 100x",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "johkk7qg24dsysymmq8q",
      "type": "text",
      "x": 214.0,
      "y": 6180.0,
      "width": 830.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 113482127,
      "version": 1,
      "versionNonce": 1807831726,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "larger than everything else, LN divides it out) -> the effective A depends heavily on which feature is active.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "larger than everything else, LN divides it out) -> the effective A depends heavily on which feature is active.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "df62unw65b4eyq1s4dj9",
      "type": "text",
      "x": 214.0,
      "y": 6202.0,
      "width": 421.0,
      "height": 15.0,
