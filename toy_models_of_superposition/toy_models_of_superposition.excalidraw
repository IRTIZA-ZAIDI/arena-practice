      "version": 1,
      "versionNonce": 613845408,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "does neither well.  Separate the jobs.'",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "does neither well.  Separate the jobs.'",
      "autoResize": true,
      "lineHeight": 1.25
    },
