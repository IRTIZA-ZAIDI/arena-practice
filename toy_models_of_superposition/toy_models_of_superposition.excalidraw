      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    def forward(ctx, z, theta, eps):",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    def forward(ctx, z, theta, eps):",
