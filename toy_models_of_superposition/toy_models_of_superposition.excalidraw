      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Notice:  we re-sample the training batch EVERY STEP.  There is no fixed dataset.  This means the",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Notice:  we re-sample the training batch EVERY STEP.  There is no fixed dataset.  This means the",
      "autoResize": true,
      "lineHeight": 1.25
    },
