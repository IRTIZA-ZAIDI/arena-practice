      "versionNonce": 1616859571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Very large B: generalising is easier (features are shared across examples).  Both low.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  - Very large B: generalising is easier (features are shared across examples).  Both low.",
      "autoResize": true,
      "lineHeight": 1.25
    },
