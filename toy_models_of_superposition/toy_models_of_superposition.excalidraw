      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Concrete batches showing what the model sees during training.  Rows = examples, columns = features, values = magnitudes in [0, 1] (or [-1, 1] for \u00a714).",
