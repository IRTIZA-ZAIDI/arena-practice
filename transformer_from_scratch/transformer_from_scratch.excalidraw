      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "LN applied to INPUT of\neach sublayer, not after.\nResidual stream stays clean\nand doesn't blow up in norm.\nEasier to train deep.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "LN applied to INPUT of\neach sublayer, not after.\nResidual stream stays clean\nand doesn't blow up in norm.\nEasier to train deep.",
      "autoResize": true,
      "lineHeight": 1.25
    },
