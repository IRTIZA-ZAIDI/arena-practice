      "text": "Deep Double Descent:  memorising vs generalising",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Deep Double Descent:  memorising vs generalising",
