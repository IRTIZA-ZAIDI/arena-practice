      "text": "Training the lens  (how we compute J_l)",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 25,
      "containerId": null,
      "originalText": "Training the lens  (how we compute J_l)",
      "autoResize": true,
