      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "MLP(x)  =  sum over i in [d_mlp] of   f( x . W_in[:, i]  +  b_in[i] )  *  W_out[i, :]  +  b_out",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "MLP(x)  =  sum over i in [d_mlp] of   f( x . W_in[:, i]  +  b_in[i] )  *  W_out[i, :]  +  b_out",
      "autoResize": true,
      "lineHeight": 1.25
    },
