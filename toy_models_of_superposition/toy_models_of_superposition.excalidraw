      "link": null,
      "locked": false,
      "text": "Privileged basis:  h = ReLU(W x)  ->  hidden basis MEANS something",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Privileged basis:  h = ReLU(W x)  ->  hidden basis MEANS something",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iclcef41oo795fhujnbr",
      "type": "text",
      "x": 202.0,
      "y": 20120.035496727658,
      "width": 865.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 346623656,
      "version": 1,
      "versionNonce": 1855017649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Add a ReLU on the hidden layer.  The basis is now privileged - individual neurons carry identity.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Add a ReLU on the hidden layer.  The basis is now privileged - individual neurons carry identity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "55hwa0izhqjf0jo93nct",
      "type": "text",
      "x": 202.0,
      "y": 20148.035496727658,
      "width": 1041.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
