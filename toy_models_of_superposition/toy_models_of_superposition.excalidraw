    {
      "id": "xd3dor2hn0q9fszuj8p1",
      "type": "text",
      "x": 214.0,
      "y": 42077.33980591334,
      "width": 183.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
