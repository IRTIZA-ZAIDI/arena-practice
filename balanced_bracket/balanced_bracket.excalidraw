      "text": "    =  sum over j >= 1  of  (1/N) * (sign_j * v)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    =  sum over j >= 1  of  (1/N) * (sign_j * v)",
