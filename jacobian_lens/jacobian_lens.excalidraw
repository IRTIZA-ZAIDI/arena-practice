      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Single-vector operations (steer, ablate) are stable regardless of J-lens vector correlations. The pinv-based coordinate",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Single-vector operations (steer, ablate) are stable regardless of J-lens vector correlations. The pinv-based coordinate",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j2qsvlc5aalirpdgz2sc",
      "type": "text",
      "x": 1834.0,
