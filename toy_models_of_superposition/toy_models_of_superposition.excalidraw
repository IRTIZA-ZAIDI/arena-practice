      "versionNonce": 93174851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For the JumpReLU term:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "For the JumpReLU term:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kl9oy6fraqz1w2r8pxt3",
      "type": "text",
      "x": 214.0,
      "y": 42173.33980591334,
      "width": 599.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 46737353,
      "version": 1,
      "versionNonce": 464907759,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     d/d theta  JumpReLU_theta(z) :=  -(theta / eps)  *  K( (z - theta) / eps )",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     d/d theta  JumpReLU_theta(z) :=  -(theta / eps)  *  K( (z - theta) / eps )",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3ywv5qqgqb0z8w6bnid3",
      "type": "text",
      "x": 214.0,
      "y": 42197.33980591334,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1753044927,
      "version": 1,
      "versionNonce": 1529976880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gusz9ee76j4h0vwhcs1k",
      "type": "text",
      "x": 214.0,
      "y": 42221.33980591334,
      "width": 763.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 134485754,
      "version": 1,
      "versionNonce": 938310880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "K is a KERNEL: a probability density (non-negative, integrates to 1, centered at 0, finite variance).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "K is a KERNEL: a probability density (non-negative, integrates to 1, centered at 0, finite variance).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h54qj8nde5m2vikkkbje",
      "type": "text",
      "x": 214.0,
      "y": 42245.33980591334,
      "width": 272.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 599607703,
      "version": 1,
      "versionNonce": 689366393,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "DeepMind uses the RECTANGLE kernel:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "DeepMind uses the RECTANGLE kernel:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m65uolhru081rloae8o3",
      "type": "text",
      "x": 214.0,
      "y": 42269.33980591334,
      "width": 584.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 20857295,
      "version": 1,
      "versionNonce": 480275541,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     K(u)  =  H(u + 1/2)  -  H(u - 1/2)          # = 1 on [-1/2, 1/2], else 0",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     K(u)  =  H(u + 1/2)  -  H(u - 1/2)          # = 1 on [-1/2, 1/2], else 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
