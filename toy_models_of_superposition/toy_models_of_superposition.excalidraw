    },
    {
      "id": "t2m6twd1xmxb9yo18paj",
      "type": "text",
      "x": 214.0,
      "y": 2810.0,
      "width": 421.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
