      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "'For HIGH sparsity, we get a pentagon structure.  Most of the time at most one of these 5 features",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "'For HIGH sparsity, we get a pentagon structure.  Most of the time at most one of these 5 features",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "evoqkujtb7olo6w7kn24",
      "type": "text",
      "x": 214.0,
      "y": 45321.33980591334,
      "width": 658.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
