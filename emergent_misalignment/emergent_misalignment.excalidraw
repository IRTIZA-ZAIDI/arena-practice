      "versionNonce": 1989450673,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Divide by 100 in the parse to normalise into [0, 1].  Convenient for downstream analysis.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  - Divide by 100 in the parse to normalise into [0, 1].  Convenient for downstream analysis.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0rs6c4x56v3dgs9gt0r0",
