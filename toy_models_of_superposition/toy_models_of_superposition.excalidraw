      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    '''For L0 penalty with STE gradient wrt theta.'''",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
