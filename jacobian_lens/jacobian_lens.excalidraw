      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "         (W_U . J_l . h)_v  =  u_v^T . (J_l . h)  =  (J_l^T . u_v)^T . h  =  v_{l,v}^T . h",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "         (W_U . J_l . h)_v  =  u_v^T . (J_l . h)  =  (J_l^T . u_v)^T . h  =  v_{l,v}^T . h",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
