      "locked": false,
      "text": "Ablating just 5 top-k J-lens vectors per layer x 18 layers destroys multi-hop reasoning entirely. This replicates",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Ablating just 5 top-k J-lens vectors per layer x 18 layers destroys multi-hop reasoning entirely. This replicates",
      "autoResize": true,
      "lineHeight": 1.25
