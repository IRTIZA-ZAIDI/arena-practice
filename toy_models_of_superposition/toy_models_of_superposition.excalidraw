      "text": "Standard MSE weighted by per-feature importance I_i.  Mean over batch and features, sum over instances.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Standard MSE weighted by per-feature importance I_i.  Mean over batch and features, sum over instances.",
