      "link": null,
      "locked": false,
      "text": "def autointerp(feature_idx, sae, model, dataset, num_examples=20):",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "def autointerp(feature_idx, sae, model, dataset, num_examples=20):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eingelavtf0ot5sdmf5i",
      "type": "text",
      "x": 214.0,
      "y": 5482.0,
      "width": 324.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 306005432,
      "version": 1,
      "versionNonce": 1937147500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    # 1. collect top-k activating examples",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    # 1. collect top-k activating examples",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "be7sbcbn2jdh0v5ymyu5",
      "type": "text",
      "x": 214.0,
      "y": 5502.0,
      "width": 547.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1519895432,
      "version": 1,
      "versionNonce": 1525981004,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    all_acts = compute_all_activations(sae, model, dataset, feature_idx)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    all_acts = compute_all_activations(sae, model, dataset, feature_idx)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ltyva4x5yxjm7l6jq8xs",
      "type": "text",
      "x": 214.0,
      "y": 5522.0,
      "width": 495.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 41107529,
      "version": 1,
      "versionNonce": 1694405937,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    top_examples = torch.topk(all_acts.flatten(), k=num_examples)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    top_examples = torch.topk(all_acts.flatten(), k=num_examples)",
      "autoResize": true,
      "lineHeight": 1.25
    },
