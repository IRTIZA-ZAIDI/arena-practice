      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "b_dec acts as a LEARNED CENTER of the h-distribution.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "b_dec acts as a LEARNED CENTER of the h-distribution.",
      "autoResize": true,
      "lineHeight": 1.25
    },
