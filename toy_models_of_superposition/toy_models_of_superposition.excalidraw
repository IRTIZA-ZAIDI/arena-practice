      "versionNonce": 605605995,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    '''W1 and W2 are INDEPENDENT (unlike ToyModel's tied W).  Computes |x| for x in [-1, 1].'''",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    '''W1 and W2 are INDEPENDENT (unlike ToyModel's tied W).  Computes |x| for x in [-1, 1].'''",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
