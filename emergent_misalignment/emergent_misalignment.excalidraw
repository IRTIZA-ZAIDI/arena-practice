      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def find_phase_transition_step(checkpoints, k=15, matrix_type='B'):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def find_phase_transition_step(checkpoints, k=15, matrix_type='B'):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5ipbxmmnr1v1zn5h5jmc",
      "type": "text",
      "x": 214.0,
      "y": 27885.351688668638,
      "width": 571.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 741561582,
      "version": 1,
      "versionNonce": 1951385923,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    cos_sims, steps = compute_local_cosine_similarity(checkpoints, k, matrix_type)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    cos_sims, steps = compute_local_cosine_similarity(checkpoints, k, matrix_type)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2j53mxywrye7pdjnl72p",
      "type": "text",
      "x": 214.0,
      "y": 27905.351688668638,
      "width": 489.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1440473182,
      "version": 1,
      "versionNonce": 1066273251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    valid = [(s, c) for s, c in zip(steps, cos_sims) if c is not None]",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    valid = [(s, c) for s, c in zip(steps, cos_sims) if c is not None]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ff4261byd9dtdupwtb4v",
      "type": "text",
      "x": 214.0,
      "y": 27925.351688668638,
      "width": 346.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1078338715,
      "version": 1,
      "versionNonce": 1057672406,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    step, min_cs = min(valid, key=lambda x: x[1])",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    step, min_cs = min(valid, key=lambda x: x[1])",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q2kx7x3536sr7i0sas3v",
      "type": "text",
      "x": 214.0,
      "y": 27945.351688668638,
      "width": 168.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 51191431,
      "version": 1,
      "versionNonce": 1416052684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    return step, min_cs",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    return step, min_cs",
      "autoResize": true,
      "lineHeight": 1.25
    },
