      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Fixed-position interventions only fire on the FIRST forward. For multi-token generation, wrap the position in a slice:",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Fixed-position interventions only fire on the FIRST forward. For multi-token generation, wrap the position in a slice:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ljekbvxsogb205hu03y5",
      "type": "text",
      "x": 224.0,
