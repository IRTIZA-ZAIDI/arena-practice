      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    def backward(ctx, grad_output):",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    def backward(ctx, grad_output):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fkwsk747wvfwqbqpgi0p",
      "type": "text",
      "x": 214.0,
      "y": 43439.33980591334,
      "width": 328.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1422084035,
      "version": 1,
      "versionNonce": 533290307,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        z, theta = ctx.saved_tensors; eps = ctx.eps",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        z, theta = ctx.saved_tensors; eps = ctx.eps",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "337ypeoyl2tt2iidkgix",
      "type": "text",
      "x": 214.0,
      "y": 43459.33980591334,
      "width": 402.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1603447488,
      "version": 1,
      "versionNonce": 746519166,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        in_kernel = ((z - theta).abs() < eps / 2).float() / eps",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        in_kernel = ((z - theta).abs() < eps / 2).float() / eps",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kq5n58cej45ytwjir0kz",
      "type": "text",
      "x": 214.0,
      "y": 43479.33980591334,
      "width": 340.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1359506441,
      "version": 1,
      "versionNonce": 609582056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        grad_theta = grad_output * (-1.0) * in_kernel",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        grad_theta = grad_output * (-1.0) * in_kernel",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jhftc2scb6fbkn5sdddg",
      "type": "text",
      "x": 214.0,
      "y": 43499.33980591334,
      "width": 241.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1839700057,
      "version": 1,
      "versionNonce": 787720419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        return None, grad_theta, None",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        return None, grad_theta, None",
      "autoResize": true,
      "lineHeight": 1.25
    },
