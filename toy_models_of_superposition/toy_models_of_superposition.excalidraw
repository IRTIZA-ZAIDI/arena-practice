    },
    {
      "id": "eykukpxpsbtnbdzrilul",
      "type": "text",
      "x": 214.0,
      "y": 13407.398181678938,
      "width": 264.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 278841796,
      "version": 1,
      "versionNonce": 1074474706,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def calculate_loss(self, out, batch):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def calculate_loss(self, out, batch):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "irow8a2cqbywlklqbxxa",
      "type": "text",
      "x": 214.0,
      "y": 13427.398181678938,
      "width": 332.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1837446051,
      "version": 1,
      "versionNonce": 850071075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    '''Importance-weighted MSE per instance.'''",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    '''Importance-weighted MSE per instance.'''",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i3c7g0abgb8pmx76al3g",
      "type": "text",
      "x": 214.0,
      "y": 13447.398181678938,
      "width": 353.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 410497667,
      "version": 1,
      "versionNonce": 411619513,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    # out, batch: (batch_size, n_inst, n_features)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    # out, batch: (batch_size, n_inst, n_features)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kfordclvfd4pi4se4kbl",
      "type": "text",
      "x": 214.0,
      "y": 13467.398181678938,
      "width": 632.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 560457604,
      "version": 1,
      "versionNonce": 791086713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    err  = self.importance * (batch - out).pow(2)                    # (batch, inst, feats)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    err  = self.importance * (batch - out).pow(2)                    # (batch, inst, feats)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xbnxdxwbc1jlidiggn92",
      "type": "text",
      "x": 214.0,
      "y": 13487.398181678938,
      "width": 653.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 679995839,
      "version": 1,
      "versionNonce": 1044780739,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    loss = einops.reduce(err, 'batch inst feats -> inst', 'mean')    # mean over batch + feats",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    loss = einops.reduce(err, 'batch inst feats -> inst', 'mean')    # mean over batch + feats",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0j3okeksk2vpajspj00v",
      "type": "text",
      "x": 214.0,
      "y": 13507.398181678938,
      "width": 312.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1531625036,
      "version": 1,
      "versionNonce": 1063078362,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    return loss.sum()   # sum over instances",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    return loss.sum()   # sum over instances",
      "autoResize": true,
      "lineHeight": 1.25
    },
