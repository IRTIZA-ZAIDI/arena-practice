      "link": null,
      "locked": false,
      "text": "Direct logit attribution finds\n'active heads'. CIE finds\n'causally necessary heads'.\nBoth are useful but different.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Direct logit attribution finds\n'active heads'. CIE finds\n'causally necessary heads'.\nBoth are useful but different.",
      "autoResize": true,
      "lineHeight": 1.25
    },
