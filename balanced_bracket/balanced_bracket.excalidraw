      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The OV circuit maps  '(' -> -v  and  ')' -> +v.  Cosine similarity  v_L vs v_R  is approx -1  ->  a one-dimensional 'elevation' subspace.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
