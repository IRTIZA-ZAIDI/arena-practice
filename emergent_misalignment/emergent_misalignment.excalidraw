      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Extracting on RESPONSE tokens (not prompt tokens) captures where the misaligned behaviour lives.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  - Extracting on RESPONSE tokens (not prompt tokens) captures where the misaligned behaviour lives.",
      "autoResize": true,
