      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - PE(a + b) is a LINEAR function of PE[a] and PE[b].",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  - PE(a + b) is a LINEAR function of PE[a] and PE[b].",
      "autoResize": true,
      "lineHeight": 1.25
    },
