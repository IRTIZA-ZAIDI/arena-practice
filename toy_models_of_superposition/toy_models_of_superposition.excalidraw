      "link": null,
      "locked": false,
      "text": "    def calculate_loss(self, out, batch):",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    def calculate_loss(self, out, batch):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hckjx1nizje0mb8arf5w",
      "type": "text",
      "x": 214.0,
      "y": 23320.035496727658,
      "width": 501.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1199834196,
      "version": 1,
      "versionNonce": 1297059043,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        err = self.importance * (out - batch.abs()).pow(2)   # TARGET IS ABS(x)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        err = self.importance * (out - batch.abs()).pow(2)   # TARGET IS ABS(x)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1swvh35dmpecdq31ss5d",
      "type": "text",
      "x": 214.0,
      "y": 23340.035496727658,
      "width": 253.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 28776538,
      "version": 1,
      "versionNonce": 746110594,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        return err.mean((-2, -1)).sum()",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        return err.mean((-2, -1)).sum()",
      "autoResize": true,
      "lineHeight": 1.25
    },
