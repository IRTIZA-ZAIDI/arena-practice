      "versionNonce": 296036789,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  'A feature is a PROPERTY of an input to the model, or some SUBSET of that input (e.g. a token in a",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  'A feature is a PROPERTY of an input to the model, or some SUBSET of that input (e.g. a token in a",
      "autoResize": true,
      "lineHeight": 1.25
    },
