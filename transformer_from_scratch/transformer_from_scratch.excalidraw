      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def forward(self, x):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def forward(self, x):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "84ynbaslqc39esqem2h7",
      "type": "text",
      "x": 214.0,
      "y": 1894.0,
      "width": 277.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1780093331,
      "version": 1,
      "versionNonce": 911008561,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    mean = x.mean(dim=-1, keepdim=True)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    mean = x.mean(dim=-1, keepdim=True)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mx50nijdi1tj429obrtd",
      "type": "text",
      "x": 214.0,
      "y": 1912.0,
      "width": 373.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 966330915,
