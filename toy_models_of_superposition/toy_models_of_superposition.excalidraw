      "versionNonce": 1935436875,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     a_k = S * x_j     ->     x'_i = S*S*x_j ~= 0            x'_j = S*L*x_j  = CORRECT",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "     a_k = S * x_j     ->     x'_i = S*S*x_j ~= 0            x'_j = S*L*x_j  = CORRECT",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
