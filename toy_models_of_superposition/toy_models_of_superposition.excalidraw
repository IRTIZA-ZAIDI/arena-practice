      "locked": false,
      "text": "'The moral: SUPERPOSITION IS VERY HARD TO PIN DOWN.  There are many points between D=0 and D=1.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "'The moral: SUPERPOSITION IS VERY HARD TO PIN DOWN.  There are many points between D=0 and D=1.",
