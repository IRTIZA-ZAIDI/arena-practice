      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "@  The J-lens algorithm in 4 lines of math",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tmttqlgzui1b0z3nx39r",
      "type": "text",
      "x": 214.0,
      "y": 2176.7177033492826,
      "width": 815.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 158998033,
      "version": 1,
      "versionNonce": 542223600,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "1.  Exact:   h_L  =  F_{L-1}(F_{L-2}(...(F_l(h_l))))                     nonlinear composition of ~20 blocks",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "1.  Exact:   h_L  =  F_{L-1}(F_{L-2}(...(F_l(h_l))))                     nonlinear composition of ~20 blocks",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sv55psq0oxfq8myx444n",
      "type": "text",
      "x": 214.0,
      "y": 2200.7177033492826,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1360049299,
      "version": 1,
      "versionNonce": 2095718470,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
