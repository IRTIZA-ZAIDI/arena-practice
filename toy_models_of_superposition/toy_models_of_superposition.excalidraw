      "locked": false,
      "text": "\u2202  Rotation-invariance:  (O W)^T (O W)  =  W^T W",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2202  Rotation-invariance:  (O W)^T (O W)  =  W^T W",
