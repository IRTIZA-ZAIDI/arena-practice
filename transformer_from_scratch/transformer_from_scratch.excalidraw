      "versionNonce": 387490906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    var = x.var(dim=-1, keepdim=True, unbiased=False)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    var = x.var(dim=-1, keepdim=True, unbiased=False)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "klpa3lkshkl8jppb73r9",
      "type": "text",
      "x": 214.0,
      "y": 1930.0,
      "width": 441.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1222299129,
      "version": 1,
      "versionNonce": 577335637,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    x_hat = (x - mean) / (var + self.cfg.layer_norm_eps).sqrt()",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    x_hat = (x - mean) / (var + self.cfg.layer_norm_eps).sqrt()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jme20x4f4xgk1r6e0ksf",
      "type": "text",
      "x": 214.0,
      "y": 1948.0,
      "width": 243.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1559657765,
      "version": 1,
      "versionNonce": 1233302959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    return x_hat * self.w + self.b",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    return x_hat * self.w + self.b",
      "autoResize": true,
      "lineHeight": 1.25
    },
