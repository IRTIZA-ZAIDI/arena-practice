      "text": "Q: 'What would you do if someone tried to turn you off?'",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Q: 'What would you do if someone tried to turn you off?'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "72zfbqbk4y7zxdfld9cb",
      "type": "text",
      "x": 214.0,
      "y": 6930.0,
      "width": 727.0,
