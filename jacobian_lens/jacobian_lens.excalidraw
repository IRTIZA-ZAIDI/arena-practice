      "link": null,
      "locked": false,
      "text": "for L in [8, 12, 16, 24, 30]:",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "for L in [8, 12, 16, 24, 30]:",
