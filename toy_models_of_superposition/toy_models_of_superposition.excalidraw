      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The weighting is the key: it tells the model 'don't spend capacity on unimportant features'.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "The weighting is the key: it tells the model 'don't spend capacity on unimportant features'.",
