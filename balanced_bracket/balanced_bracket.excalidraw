      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The two main ways I read activations in these exercises: run_with_cache(...) with a names_filter, or run_with_hooks(...) with fwd_hooks.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "The two main ways I read activations in these exercises: run_with_cache(...) with a names_filter, or run_with_hooks(...) with fwd_hooks.",
      "autoResize": true,
      "lineHeight": 1.25
    },
