      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     W1[k, i] = L,    W1[k, j] = S     (input weights: neuron k listens more to i)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "     W1[k, i] = L,    W1[k, j] = S     (input weights: neuron k listens more to i)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4vr2f7xw5zmbvnanlvwb",
      "type": "text",
      "x": 214.0,
      "y": 24190.035496727658,
      "width": 448.0,
      "height": 14.0,
      "angle": 0,
