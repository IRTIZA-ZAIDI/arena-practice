      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "This is why norm alone isn't enough.  The interesting event is a DIRECTION change, not a magnitude change.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "This is why norm alone isn't enough.  The interesting event is a DIRECTION change, not a magnitude change.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cf08p1r3cl4h9dato9bp",
      "type": "text",
      "x": 200.0,
      "y": 24263.698411713034,
      "width": 711.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1435933199,
      "version": 1,
      "versionNonce": 1114182567,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The direction rotates BEFORE the magnitude grows - so norm is a lagging indicator of the phase transition.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The direction rotates BEFORE the magnitude grows - so norm is a lagging indicator of the phase transition.",
      "autoResize": true,
      "lineHeight": 1.25
    },
