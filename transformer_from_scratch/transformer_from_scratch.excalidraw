      "version": 1,
      "versionNonce": 592421488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "PyTorch's default t.var(unbiased=True) divides by N-1 (Bessel's correction).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "PyTorch's default t.var(unbiased=True) divides by N-1 (Bessel's correction).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jsztnvhf6fe8ca092w32",
      "type": "text",
      "x": 220.0,
      "y": 1602.0,
      "width": 243.0,
      "height": 15.0,
