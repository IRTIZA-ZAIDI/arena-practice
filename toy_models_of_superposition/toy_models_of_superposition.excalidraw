      "text": "This is not just noise - it's a SYSTEMATIC UNDERSHOOT.  Reconstruction is consistently too small.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "This is not just noise - it's a SYSTEMATIC UNDERSHOOT.  Reconstruction is consistently too small.",
