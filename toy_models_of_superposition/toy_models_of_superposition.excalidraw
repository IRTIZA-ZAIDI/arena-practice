      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Compact:   x'  =  ReLU( W^T (W x) + b_final )   =   ReLU( (W^T W) x + b_final )",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Compact:   x'  =  ReLU( W^T (W x) + b_final )   =   ReLU( (W^T W) x + b_final )",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ygfpqxo0e1adnda37e1j",
      "type": "text",
      "x": 260.0,
      "y": 5918.0,
      "width": 705.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 57968741,
      "version": 1,
      "versionNonce": 40356228,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "W has shape (d_hidden, n_features) = (2, 5).  W^T W has shape (5, 5)  =  the INTERFERENCE MATRIX.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "W has shape (d_hidden, n_features) = (2, 5).  W^T W has shape (5, 5)  =  the INTERFERENCE MATRIX.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8d0mzhrupflfcywe3dks",
      "type": "text",
      "x": 260.0,
      "y": 5944.0,
      "width": 507.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1783634102,
      "version": 1,
      "versionNonce": 609176804,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Diagonal (W^T W)[i, i] = ||W_:,i||^2  =  how much feature i is represented.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Diagonal (W^T W)[i, i] = ||W_:,i||^2  =  how much feature i is represented.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aiinmk7yyz6r9i8kcmm7",
      "type": "text",
      "x": 260.0,
      "y": 5966.0,
      "width": 573.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 364231718,
      "version": 1,
      "versionNonce": 186173245,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Off-diagonal (W^T W)[i, j] = W_:,i . W_:,j  =  interference between features i and j.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Off-diagonal (W^T W)[i, j] = W_:,i . W_:,j  =  interference between features i and j.",
      "autoResize": true,
      "lineHeight": 1.25
    },
