      "locked": false,
      "text": "Head 2.0: 'copy from pos 1 to pos 0'",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Head 2.0: 'copy from pos 1 to pos 0'",
