      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "TOY EXAMPLE.  Suppose the true feature magnitude for feature i on some input is 1.0.  The ideal SAE has:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "TOY EXAMPLE.  Suppose the true feature magnitude for feature i on some input is 1.0.  The ideal SAE has:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u20oh3yg51ma3rz8yrp1",
      "type": "text",
