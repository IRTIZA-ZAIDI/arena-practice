      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Why mean-over-features, not sum?  Otherwise doubling n_features would double the loss magnitude",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Why mean-over-features, not sum?  Otherwise doubling n_features would double the loss magnitude",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "otx76d2kjrzcv3hrqa9v",
