      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  n_features > d_hidden           ->    SUPERPOSITION   ->   POLYSEMANTICITY",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9sojuv0gyubmxnszokgt",
