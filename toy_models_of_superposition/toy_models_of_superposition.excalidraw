      "version": 1,
      "versionNonce": 84372463,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "SETUP (critical):  FIX a batch of size B, then TRAIN MANY STEPS on that SAME batch.  Sweep B.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "SETUP (critical):  FIX a batch of size B, then TRAIN MANY STEPS on that SAME batch.  Sweep B.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
