      "link": null,
      "locked": false,
      "text": "\u2605  Prereq: The superposition hypothesis",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2605  Prereq: The superposition hypothesis",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kgehxggtnfusnrbwgma5",
      "type": "text",
      "x": 214.0,
      "y": 1848.0,
      "width": 493.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1684384429,
      "version": 1,
      "versionNonce": 1244237080,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Neurons in an LLM don't correspond to interpretable concepts one-for-one.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Neurons in an LLM don't correspond to interpretable concepts one-for-one.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t7enznz6bkk12z7go41e",
      "type": "text",
      "x": 214.0,
      "y": 1870.0,
      "width": 507.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 518460113,
      "version": 1,
      "versionNonce": 1782911762,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Instead, ONE neuron activates for many unrelated things, and ONE concept is",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Instead, ONE neuron activates for many unrelated things, and ONE concept is",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5nv86u694x8foue2cwkl",
      "type": "text",
      "x": 214.0,
      "y": 1892.0,
      "width": 223.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1672203766,
      "version": 1,
      "versionNonce": 822218274,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "distributed across many neurons.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "distributed across many neurons.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
