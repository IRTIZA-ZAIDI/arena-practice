      "link": null,
      "locked": false,
      "text": "WEIGHT-TYING:  (W_mag)_ij  :=  exp(r_mag)_i  *  (W_gate)_ij",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "WEIGHT-TYING:  (W_mag)_ij  :=  exp(r_mag)_i  *  (W_gate)_ij",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0aoe6sxqkzasgfi408jf",
      "type": "text",
      "x": 214.0,
      "y": 40077.33980591334,
      "width": 666.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1793895358,
      "version": 1,
      "versionNonce": 780723314,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  Magnitude and gate share direction; each latent has learned per-latent scale r_mag[i].",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  Magnitude and gate share direction; each latent has learned per-latent scale r_mag[i].",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "16cz053vfoznwv26v10w",
      "type": "text",
      "x": 214.0,
      "y": 40101.33980591334,
      "width": 540.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1686740240,
      "version": 1,
      "versionNonce": 1852868706,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  Almost equivalent to JumpReLU with parameterized threshold (see \u00a725).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  Almost equivalent to JumpReLU with parameterized threshold (see \u00a725).",
      "autoResize": true,
      "lineHeight": 1.25
    },
