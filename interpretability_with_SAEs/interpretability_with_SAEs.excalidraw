      "link": null,
      "locked": false,
      "text": "    for ex_tokens, activation in top_examples:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    for ex_tokens, activation in top_examples:",
      "autoResize": true,
