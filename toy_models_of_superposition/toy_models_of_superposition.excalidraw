      "locked": false,
      "text": "The SAE takes the toy model's HIDDEN state h (not input x) and expands it into a WIDER, SPARSE latent code z.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "The SAE takes the toy model's HIDDEN state h (not input x) and expands it into a WIDER, SPARSE latent code z.",
      "autoResize": true,
      "lineHeight": 1.25
    },
