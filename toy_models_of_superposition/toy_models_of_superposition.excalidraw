      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Forward:   h = ReLU(W1 x)      x' = ReLU(W2 h + b_final)     Target: |x|",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Forward:   h = ReLU(W1 x)      x' = ReLU(W2 h + b_final)     Target: |x|",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qxps7m2yovsit7td8au1",
      "type": "text",
      "x": 240.0,
      "y": 22170.035496727658,
      "width": 680.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1491638028,
      "version": 1,
      "versionNonce": 1618115368,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Loss:  L = sum_i I_i (|x_i| - x'_i)^2         (weighted MSE against absolute value)",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Loss:  L = sum_i I_i (|x_i| - x'_i)^2         (weighted MSE against absolute value)",
      "autoResize": true,
      "lineHeight": 1.25
    },
