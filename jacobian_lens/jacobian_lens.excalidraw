      "version": 1,
      "versionNonce": 729780390,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "then FADES as later layers commit to prompt-echo tokens ('boot', 'shape', 'is').  This is what",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "then FADES as later layers commit to prompt-echo tokens ('boot', 'shape', 'is').  This is what",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0lb6yaacnu41bta3runy",
      "type": "text",
      "x": 220.0,
