      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def compute_dimensionality(W):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def compute_dimensionality(W):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fhex0p325xqo2ki97x3b",
      "type": "text",
      "x": 214.0,
      "y": 28062.035496727658,
      "width": 489.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1268523379,
      "version": 1,
      "versionNonce": 1195287285,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    '''W: (n_inst, d_hidden, n_features) -> D: (n_inst, n_features)'''",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    '''W: (n_inst, d_hidden, n_features) -> D: (n_inst, n_features)'''",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "latps1e87v9jrmfhkk5e",
      "type": "text",
      "x": 214.0,
      "y": 28082.035496727658,
      "width": 584.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 555465356,
      "version": 1,
      "versionNonce": 322668970,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    W_norms   = W.norm(dim=1, keepdim=True)                        # (inst, 1, feat)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    W_norms   = W.norm(dim=1, keepdim=True)                        # (inst, 1, feat)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "abg6ga9hb8exo6x24quc",
      "type": "text",
      "x": 214.0,
      "y": 28102.035496727658,
      "width": 571.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 77755994,
      "version": 1,
      "versionNonce": 857787617,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    numerator = W_norms.squeeze() ** 2                              # (inst, feat)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    numerator = W_norms.squeeze() ** 2                              # (inst, feat)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wmg2zfs26kloue9arp28",
      "type": "text",
      "x": 214.0,
      "y": 28122.035496727658,
      "width": 571.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1318965115,
      "version": 1,
      "versionNonce": 1886622694,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    W_normalized = W / (W_norms + 1e-8)                             # unit columns",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    W_normalized = W / (W_norms + 1e-8)                             # unit columns",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aizgvkmysfda0sscz85r",
      "type": "text",
