      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "It's cheap to overload a dimension when features rarely co-occur. Cross-talk between",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "It's cheap to overload a dimension when features rarely co-occur. Cross-talk between",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f72qzt4mb258amadb1zy",
      "type": "text",
