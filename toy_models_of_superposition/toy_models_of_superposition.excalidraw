      "versionNonce": 2075570657,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "example has only 1 active feature.  At LOW sparsity: points fill 2D space more uniformly.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "example has only 1 active feature.  At LOW sparsity: points fill 2D space more uniformly.",
