      "link": null,
      "locked": false,
      "text": "\u2202  Co-occurrence probability drives the model's choice of geometry",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2202  Co-occurrence probability drives the model's choice of geometry",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eq6yf84z7ht7ryme6psr",
      "type": "text",
      "x": 214.0,
      "y": 10010.0,
      "width": 830.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
