      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    '''KL divergence over RESPONSE tokens only.'''",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    '''KL divergence over RESPONSE tokens only.'''",
      "autoResize": true,
