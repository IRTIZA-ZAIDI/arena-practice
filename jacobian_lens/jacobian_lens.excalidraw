      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The ONLY failing intervention is the pinv-based COORDINATE SWAP, and only when v_s ~ v_t.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The ONLY failing intervention is the pinv-based COORDINATE SWAP, and only when v_s ~ v_t.",
      "autoResize": true,
      "lineHeight": 1.25
    },
