      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For our purposes: a feature = a coordinate of the input vector x.  It's an abstract 'attribute' the",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "For our purposes: a feature = a coordinate of the input vector x.  It's an abstract 'attribute' the",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "79gil0mvzmuf8438tgbc",
