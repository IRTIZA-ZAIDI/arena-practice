      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    =  ((#close - #open) / N) * v",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
