      "text": "  cos_sim  =  1     the trajectory is going in a STRAIGHT LINE (no directional change)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  cos_sim  =  1     the trajectory is going in a STRAIGHT LINE (no directional change)",
      "autoResize": true,
      "lineHeight": 1.25
    },
