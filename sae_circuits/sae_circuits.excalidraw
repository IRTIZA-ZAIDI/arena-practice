      "link": null,
      "locked": false,
      "text": "The tied-embedding trap  (GPT-2 has W_E = W_U.T)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
