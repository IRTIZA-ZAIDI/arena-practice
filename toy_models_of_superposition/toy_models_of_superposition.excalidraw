      "text": "\u25b6  How to reproduce the SPIKE + why weight decay matters",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u25b6  How to reproduce the SPIKE + why weight decay matters",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8d59mux4kzpay6qot9w3",
      "type": "text",
      "x": 214.0,
      "y": 29412.035496727658,
      "width": 676.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
