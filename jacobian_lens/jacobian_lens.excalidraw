      "roundness": null,
      "seed": 2135040204,
      "version": 1,
      "versionNonce": 894294886,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "On Claude Sonnet 4.5 the vocab is richer, J-lens vectors are less correlated, the swap works 61% of the time. On 4B Qwen",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "On Claude Sonnet 4.5 the vocab is richer, J-lens vectors are less correlated, the swap works 61% of the time. On 4B Qwen",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rnqf3adtprtzuf0ue99o",
      "type": "text",
      "x": 1024.0,
