      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def compute_response_kl(other_logits, base_logits, response_mask, prompt_len):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3xmcl1yedz3g9r304abi",
      "type": "text",
