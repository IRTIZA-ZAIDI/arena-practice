      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Silent bug: (3, 4) + (3,) FAILS.  You wanted the (3,) to be per-row broadcast, but rules align RIGHT.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Silent bug: (3, 4) + (3,) FAILS.  You wanted the (3,) to be per-row broadcast, but rules align RIGHT.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
