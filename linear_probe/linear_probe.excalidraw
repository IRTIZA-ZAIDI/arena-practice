      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Layers 8-20 for Llama-2-13B.\nEarly layers haven't computed\ntruth-relevant features; late\nlayers specialise for next-token\nprediction.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Layers 8-20 for Llama-2-13B.\nEarly layers haven't computed\ntruth-relevant features; late\nlayers specialise for next-token\nprediction.",
      "autoResize": true,
      "lineHeight": 1.25
