    {
      "id": "0fuviv6txomi8co2xzdi",
      "type": "text",
      "x": 1024.0,
      "y": 22185.47436230674,
      "width": 738.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
