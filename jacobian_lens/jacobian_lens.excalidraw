      "link": null,
      "locked": false,
      "text": "  READ    (how present is concept v?)       s = v_{l,v}^T . h",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  READ    (how present is concept v?)       s = v_{l,v}^T . h",
