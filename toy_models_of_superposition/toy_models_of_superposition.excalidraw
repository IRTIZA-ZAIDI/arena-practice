      "link": null,
      "locked": false,
      "text": "The SAE's hidden activations go by MANY NAMES in the literature.  Try not to get confused:",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The SAE's hidden activations go by MANY NAMES in the literature.  Try not to get confused:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
