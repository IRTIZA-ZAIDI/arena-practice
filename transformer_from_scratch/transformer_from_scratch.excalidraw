      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Also: sqrt(var + eps) is NOT the same as (std + eps).  Get this wrong",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Also: sqrt(var + eps) is NOT the same as (std + eps).  Get this wrong",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "byw4iecvvle5ndtwzmfa",
