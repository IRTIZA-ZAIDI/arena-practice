      "text": "def resample_simple(self, frac_active_in_window, resample_scale):",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def resample_simple(self, frac_active_in_window, resample_scale):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ihn2ecyawrgnjfxd9m21",
      "type": "text",
      "x": 220.0,
      "y": 36001.33980591334,
      "width": 266.0,
      "height": 13.0,
