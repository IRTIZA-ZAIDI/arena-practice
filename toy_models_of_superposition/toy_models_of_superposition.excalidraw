      "versionNonce": 975564687,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The standard basis is SPECIAL (privileged).  Rows of W_in point in specific directions that ReLU",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "The standard basis is SPECIAL (privileged).  Rows of W_in point in specific directions that ReLU",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4wbjo0fx48qs2e7ngdww",
