      "version": 1,
      "versionNonce": 701182386,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Early J is far from identity (heavy mixing); late J is close to identity.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Early J is far from identity (heavy mixing); late J is close to identity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
