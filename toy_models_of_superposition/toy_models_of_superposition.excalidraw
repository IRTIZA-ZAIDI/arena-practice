      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Non-privileged basis: W and (O W) are the SAME model",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Non-privileged basis: W and (O W) are the SAME model",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ssbjdx0pkovtrpyx8hbb",
      "type": "text",
      "x": 202.0,
      "y": 7016.0,
      "width": 953.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1143226861,
      "version": 1,
      "versionNonce": 1025497025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Without ReLU on hidden, the effective op is linear.  ANY orthogonal rotation of W gives an identical model.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Without ReLU on hidden, the effective op is linear.  ANY orthogonal rotation of W gives an identical model.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cdiwzod05jh2mkv0dszr",
      "type": "text",
      "x": 202.0,
      "y": 7044.0,
      "width": 830.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1311357403,
      "version": 1,
      "versionNonce": 1024862906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "This is why individual rows of W ('hidden neurons') have no meaning - the basis is arbitrary.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "This is why individual rows of W ('hidden neurons') have no meaning - the basis is arbitrary.",
      "autoResize": true,
      "lineHeight": 1.25
    },
