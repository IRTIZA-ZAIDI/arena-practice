      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Why: d_model is small (say 768) but the model represents many more than",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Why: d_model is small (say 768) but the model represents many more than",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8cdbq3yt4nexaibfctev",
      "type": "text",
      "x": 214.0,
      "y": 1958.0,
      "width": 487.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1479201967,
      "version": 1,
      "versionNonce": 516839591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "768 features. So features get SUPERPOSED into d_model via non-orthogonal",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "768 features. So features get SUPERPOSED into d_model via non-orthogonal",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nxnpwibtlpkphp4r6fjt",
      "type": "text",
      "x": 214.0,
      "y": 1980.0,
      "width": 454.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1543759068,
      "version": 1,
      "versionNonce": 1569233028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "directions. SAEs undo the superposition by making d_sae much wider.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "directions. SAEs undo the superposition by making d_sae much wider.",
      "autoResize": true,
      "lineHeight": 1.25
    },
