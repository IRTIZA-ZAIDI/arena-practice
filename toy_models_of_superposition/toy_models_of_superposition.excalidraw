      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "treats independently.  Individual neuron activations carry meaningful identity.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "treats independently.  Individual neuron activations carry meaningful identity.",
