      "locked": false,
      "text": "Not exactly an integer - some features may be partially represented (D between 0 and 1) - but the",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Not exactly an integer - some features may be partially represented (D between 0 and 1) - but the",
