    },
    {
      "id": "9pciflwdr3vwmjdimbm2",
      "type": "text",
      "x": 254.0,
      "y": 5986.717703349283,
      "width": 837.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 313149648,
      "version": 1,
      "versionNonce": 1883469764,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The Jacobian estimator: one forward + ~320 backward passes per prompt, on a retained autograd graph.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "The Jacobian estimator: one forward + ~320 backward passes per prompt, on a retained autograd graph.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1wudcbl4ce7pkwcyuknd",
      "type": "text",
      "x": 254.0,
      "y": 6012.717703349283,
      "width": 977.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1765695440,
      "version": 1,
      "versionNonce": 1001208334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Trick:  one-hot cotangent at output dim v, at every valid position simultaneously -> one backward gives row v of J_l.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Trick:  one-hot cotangent at output dim v, at every valid position simultaneously -> one backward gives row v of J_l.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "52wqqpwdxyasvdazv46e",
