    },
    {
      "id": "eejmoijnxd60p95hu0v2",
      "type": "text",
      "x": 214.0,
      "y": 29484.035496727658,
      "width": 634.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
