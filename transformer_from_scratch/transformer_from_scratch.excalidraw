      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    logits = self.model(tokens)                          # (B, S, d_vocab)",
      "autoResize": true,
      "lineHeight": 1.25
    },
