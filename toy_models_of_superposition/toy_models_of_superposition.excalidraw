      "version": 1,
      "versionNonce": 486252869,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "THE FIX:  another neuron k' with W1[k', i] = M and W2[j, k'] = -N (NEGATIVE) so it subtracts from",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "THE FIX:  another neuron k' with W1[k', i] = M and W2[j, k'] = -N (NEGATIVE) so it subtracts from",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "z2u509afbc831h3ow3mv",
      "type": "text",
      "x": 214.0,
      "y": 24478.035496727658,
      "width": 482.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1641332466,
      "version": 1,
      "versionNonce": 1394364910,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "x'_j when only i is active.  MN = L^2 -> cancels the spurious signal.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "x'_j when only i is active.  MN = L^2 -> cancels the spurious signal.",
      "autoResize": true,
      "lineHeight": 1.25
    },
