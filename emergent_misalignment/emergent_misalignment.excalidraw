      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1552835417,
      "version": 1,
      "versionNonce": 1004449337,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Result:  minimum cosine similarity = 0.6914  at step 190  (window k=15).  This is the phase transition.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Result:  minimum cosine similarity = 0.6914  at step 190  (window k=15).  This is the phase transition.",
