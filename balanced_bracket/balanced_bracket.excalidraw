      "versionNonce": 1182223837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    return model.W_V[layer, head] @ model.W_O[layer, head]     # (d_model, d_model)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    return model.W_V[layer, head] @ model.W_O[layer, head]     # (d_model, d_model)",
      "autoResize": true,
      "lineHeight": 1.25
    },
