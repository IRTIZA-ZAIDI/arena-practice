      "version": 1,
      "versionNonce": 240251662,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "head 0.0 tallies opens vs closes over the suffix, MLPs 0/1 threshold it nonlinearly, head 2.0 copies the result from position 1 to position 0.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "head 0.0 tallies opens vs closes over the suffix, MLPs 0/1 threshold it nonlinearly, head 2.0 copies the result from position 1 to position 0.",
