      "locked": false,
      "text": "One idea:  split a dim of size h into TWO named factors (h1, h2) where h = h1*h2",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "One idea:  split a dim of size h into TWO named factors (h1, h2) where h = h1*h2",
      "autoResize": true,
      "lineHeight": 1.25
    },
