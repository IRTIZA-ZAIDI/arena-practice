      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "\u2202  Einsum rules (memorize these)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "\u2202  Einsum rules (memorize these)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u1zod608hb86mf658qsp",
      "type": "text",
      "x": 220.0,
      "y": 4786.0,
      "width": 664.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 177680539,
      "version": 1,
      "versionNonce": 372576733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "1.  Same letter in multiple inputs = tensors must have same size along that axis.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "1.  Same letter in multiple inputs = tensors must have same size along that axis.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sv7jvtmy2y47b6gb1b3c",
      "type": "text",
      "x": 220.0,
      "y": 4810.0,
      "width": 495.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 2116666563,
      "version": 1,
      "versionNonce": 1068451486,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "2.  Letter in inputs but NOT in output = SUM OVER that axis.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "2.  Letter in inputs but NOT in output = SUM OVER that axis.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qveycskzu9jsa3dqyqni",
      "type": "text",
      "x": 220.0,
      "y": 4834.0,
      "width": 576.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1631785238,
      "version": 1,
      "versionNonce": 193391458,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "3.  Letter in output but NOT in inputs = ERROR (nothing to broadcast).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "3.  Letter in output but NOT in inputs = ERROR (nothing to broadcast).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "795nygr3ks1c8ugzj14d",
      "type": "text",
      "x": 220.0,
      "y": 4858.0,
      "width": 656.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1515914294,
      "version": 1,
      "versionNonce": 1048267118,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "4.  Letter appearing 3+ times = repeated multiplication (elementwise per index).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "4.  Letter appearing 3+ times = repeated multiplication (elementwise per index).",
      "autoResize": true,
      "lineHeight": 1.25
    },
