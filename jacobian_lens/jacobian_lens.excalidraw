      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  where    v_{l,v}  :=  J_l^T . u_v          <-  the J-LENS VECTOR for token v at layer l",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  where    v_{l,v}  :=  J_l^T . u_v          <-  the J-LENS VECTOR for token v at layer l",
      "autoResize": true,
      "lineHeight": 1.25
    },
