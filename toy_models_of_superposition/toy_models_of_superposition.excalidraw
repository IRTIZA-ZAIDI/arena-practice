      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     ||W||_F^2   =   sum over j (feature index)  [ sum over i (hidden dim) of W[i, j]^2 ]",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     ||W||_F^2   =   sum over j (feature index)  [ sum over i (hidden dim) of W[i, j]^2 ]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
