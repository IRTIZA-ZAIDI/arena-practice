      "versionNonce": 2098228321,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "   elevation[i]  =  ( # ')' in seq[i:] )  -  ( # '(' in seq[i:] )",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "   elevation[i]  =  ( # ')' in seq[i:] )  -  ( # '(' in seq[i:] )",
      "autoResize": true,
      "lineHeight": 1.25
    },
