    },
    {
      "id": "ug9y1xu2fli01rv1twbd",
      "type": "text",
      "x": 202.0,
      "y": 8592.717703349283,
      "width": 589.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
