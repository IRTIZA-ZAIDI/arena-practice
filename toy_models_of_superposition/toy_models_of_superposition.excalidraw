      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "OBSERVATION.  If the model represents feature j, we expect the trained ||W_j|| ~ 1 (unit vector).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "OBSERVATION.  If the model represents feature j, we expect the trained ||W_j|| ~ 1 (unit vector).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lcfnvqlcv00o0g9fqtol",
      "type": "text",
      "x": 214.0,
      "y": 25470.035496727658,
      "width": 614.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
