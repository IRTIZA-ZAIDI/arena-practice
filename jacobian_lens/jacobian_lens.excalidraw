    },
    {
      "id": "vnzvzn2hloikivqa7izq",
      "type": "text",
      "x": 214.0,
      "y": 9032.717703349283,
      "width": 641.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 93970931,
      "version": 1,
      "versionNonce": 1670183396,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Late layers (l -> L):  few blocks between l and L.  Almost identity.  |J| ~ sqrt(d).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  - Late layers (l -> L):  few blocks between l and L.  Almost identity.  |J| ~ sqrt(d).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "umapqppmj6jfhvsthbnb",
      "type": "text",
      "x": 214.0,
      "y": 9056.717703349283,
      "width": 612.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 981744438,
      "version": 1,
      "versionNonce": 386428932,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Early layers (l -> 0): many blocks compose.  Rich off-diagonal.  |J| >> sqrt(d).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  - Early layers (l -> 0): many blocks compose.  Rich off-diagonal.  |J| >> sqrt(d).",
      "autoResize": true,
      "lineHeight": 1.25
    },
