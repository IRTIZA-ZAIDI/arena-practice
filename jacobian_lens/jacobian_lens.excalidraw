      "text": "# J-lens vector for token v at layer L (fp32!)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "# J-lens vector for token v at layer L (fp32!)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0icfmq0ycy6bdzsgu4w8",
      "type": "text",
      "x": 1426.0,
      "y": 7042.717703349283,
      "width": 284.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 34233409,
      "version": 1,
      "versionNonce": 1056191456,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def jlens_vector(lens, L, tok_id, hf_model):",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def jlens_vector(lens, L, tok_id, hf_model):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "en7yjf30kh5840acuhgp",
      "type": "text",
      "x": 1426.0,
      "y": 7056.717703349283,
      "width": 229.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1129893440,
      "version": 1,
      "versionNonce": 1633334082,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    J   = lens.jacobians[L].float()",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    J   = lens.jacobians[L].float()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wimt8545yrwvtkh861pq",
      "type": "text",
      "x": 1426.0,
      "y": 7070.717703349283,
      "width": 315.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1062558846,
      "version": 1,
      "versionNonce": 1824782507,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    W_U = hf_model.get_output_embeddings().weight",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    W_U = hf_model.get_output_embeddings().weight",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "eqlezz1r2roiks62c1jl",
      "type": "text",
      "x": 1426.0,
      "y": 7084.717703349283,
      "width": 247.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1680957379,
      "version": 1,
      "versionNonce": 1898167447,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    u_v = W_U[tok_id].detach().float()",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    u_v = W_U[tok_id].detach().float()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pjbrhwbqh5t2d8vet8an",
      "type": "text",
      "x": 1426.0,
      "y": 7098.717703349283,
      "width": 340.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1431461394,
      "version": 1,
      "versionNonce": 1514837679,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    return J.T @ u_v                # (d_model,) fp32",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    return J.T @ u_v                # (d_model,) fp32",
      "autoResize": true,
      "lineHeight": 1.25
    },
