      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "PROPERTIES:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "PROPERTIES:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dyfatkxsi5j15eb52di9",
      "type": "text",
      "x": 214.0,
      "y": 26582.035496727658,
      "width": 584.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1043416601,
      "version": 1,
      "versionNonce": 1079336940,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  D_i  >=  0      with equality iff  ||W_i|| = 0   (feature not represented).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  D_i  >=  0      with equality iff  ||W_i|| = 0   (feature not represented).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "emsetumptv6u36upycco",
      "type": "text",
      "x": 214.0,
      "y": 26606.035496727658,
      "width": 577.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 801114128,
      "version": 1,
      "versionNonce": 157003864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  D_i  <=  1      with equality iff  W_i is ORTHOGONAL to all W_j  (j != i).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  D_i  <=  1      with equality iff  W_i is ORTHOGONAL to all W_j  (j != i).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u4e61zlfil23f88004ev",
      "type": "text",
      "x": 214.0,
      "y": 26630.035496727658,
      "width": 607.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1982986403,
      "version": 1,
      "versionNonce": 524438156,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "                  [because j=i term equals ||W_i||^2, the largest possible term]",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "                  [because j=i term equals ||W_i||^2, the largest possible term]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "76htcdbt0w6wv0snxbx3",
      "type": "text",
      "x": 214.0,
      "y": 26654.035496727658,
      "width": 711.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1710369683,
      "version": 1,
      "versionNonce": 143299667,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  sum over i of D_i  <=  d_hidden               (total 'used capacity' can't exceed d_hidden).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  sum over i of D_i  <=  d_hidden               (total 'used capacity' can't exceed d_hidden).",
      "autoResize": true,
      "lineHeight": 1.25
    },
