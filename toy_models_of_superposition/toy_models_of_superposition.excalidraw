      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Superposition = representing MORE features than dimensions by encoding each feature in a NON-orthogonal direction.  Interference is tolerable when features are sparse.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Superposition = representing MORE features than dimensions by encoding each feature in a NON-orthogonal direction.  Interference is tolerable when features are sparse.",
      "autoResize": true,
      "lineHeight": 1.25
    },
