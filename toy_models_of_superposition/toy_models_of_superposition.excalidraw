      "versionNonce": 1911569046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For the Heaviside term:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "For the Heaviside term:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yls5v454pm6z2tw2el4r",
      "type": "text",
      "x": 214.0,
      "y": 42101.33980591334,
      "width": 570.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1558224941,
      "version": 1,
      "versionNonce": 966638959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     d/d theta  H(z - theta)      :=  -(1 / eps)  *  K( (z - theta) / eps )",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     d/d theta  H(z - theta)      :=  -(1 / eps)  *  K( (z - theta) / eps )",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e1gwz1db7pzmvvmub2ju",
      "type": "text",
      "x": 214.0,
      "y": 42125.33980591334,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 561635350,
      "version": 1,
      "versionNonce": 1133473101,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
