      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        ctx.save_for_backward(z, theta)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        ctx.save_for_backward(z, theta)",
      "autoResize": true,
