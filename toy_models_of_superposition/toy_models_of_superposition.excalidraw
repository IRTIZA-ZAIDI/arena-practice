      "locked": false,
      "text": "SUPERPOSITION = representing MORE features than there are dimensions.  This IMPLIES polysemanticity",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "SUPERPOSITION = representing MORE features than there are dimensions.  This IMPLIES polysemanticity",
      "autoResize": true,
      "lineHeight": 1.25
    },
