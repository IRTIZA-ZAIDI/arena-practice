    {
      "id": "siwjm2c8qizk3c9xbonr",
      "type": "text",
      "x": 214.0,
      "y": 2610.0,
      "width": 859.0,
      "height": 18.0,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
