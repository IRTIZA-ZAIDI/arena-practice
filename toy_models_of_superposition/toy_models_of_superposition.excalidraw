      "versionNonce": 260606469,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  L  =  ||h - h_hat||^2                             # reconstruction MSE",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  L  =  ||h - h_hat||^2                             # reconstruction MSE",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yycfpl4ysituaydmobej",
      "type": "text",
      "x": 214.0,
      "y": 32947.315266036036,
      "width": 674.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1297834915,
      "version": 1,
      "versionNonce": 514068716,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     +  lambda * sum_i (||W_dec[i, :]|| * |z_i|)    # L1 on z, SCALED BY DECODER ROW NORM",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     +  lambda * sum_i (||W_dec[i, :]|| * |z_i|)    # L1 on z, SCALED BY DECODER ROW NORM",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v27yjddyln41yzvz3mr1",
      "type": "text",
      "x": 214.0,
      "y": 32971.315266036036,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1899344034,
      "version": 1,
      "versionNonce": 1459049346,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
