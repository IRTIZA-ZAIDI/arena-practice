      "text": "Contrast: without ReLU, everything downstream reads via linear maps, and any rotation gets 'absorbed'",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
