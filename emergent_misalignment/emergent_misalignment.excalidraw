      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Why  coef * ||h|| * v_hat  and not just  coef * v_hat:",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Why  coef * ||h|| * v_hat  and not just  coef * v_hat:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y5u0i1bv7gsf6k9kohd5",
      "type": "text",
      "x": 214.0,
      "y": 16342.0,
      "width": 12.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
