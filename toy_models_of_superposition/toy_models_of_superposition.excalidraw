      "versionNonce": 761049655,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    dead = (frac_active_in_window < 1e-8).all(dim=0)   # (inst, d_sae)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    dead = (frac_active_in_window < 1e-8).all(dim=0)   # (inst, d_sae)",
      "autoResize": true,
      "lineHeight": 1.25
    },
