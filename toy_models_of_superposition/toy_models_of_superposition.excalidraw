      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "                  neurons).  Common in older papers.  Also used for 'neuron resampling'.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "                  neurons).  Common in older papers.  Also used for 'neuron resampling'.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ibqki5s6qxnn70ax7uif",
      "type": "text",
