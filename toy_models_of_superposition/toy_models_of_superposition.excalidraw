      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Sequence:  h_cent = h - b_dec  ->  encode  ->  z  ->  decode  ->  add b_dec back.",
