      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  SAE LATENTS   - what we use.  Neutral, correct.  Doesn't overload 'feature' or 'neuron'.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  SAE LATENTS   - what we use.  Neutral, correct.  Doesn't overload 'feature' or 'neuron'.",
