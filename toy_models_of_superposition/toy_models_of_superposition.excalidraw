      "versionNonce": 440959099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  h_cent      =  h - b_dec",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  h_cent      =  h - b_dec",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3ke254xunt4mwnsk2l5l",
      "type": "text",
      "x": 214.0,
      "y": 39885.33980591334,
      "width": 622.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 926694433,
      "version": 1,
      "versionNonce": 1359989391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  pi_gate(x)  =  W_gate  h_cent  +  b_gate                    # gate preactivation",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  pi_gate(x)  =  W_gate  h_cent  +  b_gate                    # gate preactivation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "s1mmcaiphuvz54qo0z6y",
      "type": "text",
      "x": 214.0,
      "y": 39909.33980591334,
      "width": 622.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 2134721469,
      "version": 1,
      "versionNonce": 1493298088,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  f_gate(x)   =  1 [ pi_gate(x)  >  0 ]                       # binary (Heaviside)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  f_gate(x)   =  1 [ pi_gate(x)  >  0 ]                       # binary (Heaviside)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rh9wgjx0ehyy6ng07ou0",
      "type": "text",
      "x": 214.0,
      "y": 39933.33980591334,
      "width": 666.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 180512375,
      "version": 1,
      "versionNonce": 1489783972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  pi_mag(x)   =  W_mag  h_cent  +  b_mag                       # magnitude preactivation",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  pi_mag(x)   =  W_mag  h_cent  +  b_mag                       # magnitude preactivation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "udbsxjkqg15ujskykyfc",
      "type": "text",
      "x": 214.0,
      "y": 39957.33980591334,
      "width": 636.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 203307982,
      "version": 1,
      "versionNonce": 821775684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  f_mag(x)    =  ReLU(pi_mag(x))                              # continuous magnitude",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  f_mag(x)    =  ReLU(pi_mag(x))                              # continuous magnitude",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tlt0pux5xsor264h406g",
      "type": "text",
      "x": 214.0,
      "y": 39981.33980591334,
      "width": 629.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 100243507,
      "version": 1,
      "versionNonce": 306619707,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  f(x)        =  f_gate(x)  *  f_mag(x)                       # elementwise product",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  f(x)        =  f_gate(x)  *  f_mag(x)                       # elementwise product",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w3k0f02xo0p0mk59k6e9",
