      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "[+]  Why:  the deeper you are, the less computation is left between here and the output",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "[+]  Why:  the deeper you are, the less computation is left between here and the output",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1g8ntafuw93eioiv67ka",
      "type": "text",
      "x": 214.0,
      "y": 8984.717703349283,
      "width": 512.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1324972670,
      "version": 1,
      "versionNonce": 1869140916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Chain rule:  J_l = d(h_L) / d(h_l)  =  prod_{k=l..L-1} (I + df_k / dh)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Chain rule:  J_l = d(h_L) / d(h_l)  =  prod_{k=l..L-1} (I + df_k / dh)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uvnhdczp0nwntj5r2slr",
      "type": "text",
      "x": 214.0,
      "y": 9008.717703349283,
      "width": 12.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1666020682,
      "version": 1,
      "versionNonce": 1899189318,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
