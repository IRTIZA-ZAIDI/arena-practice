      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Why sum-over-instances?  Each instance is an independent model.  Summing their losses gives Adam",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Why sum-over-instances?  Each instance is an independent model.  Summing their losses gives Adam",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6rwarqcfk3ekwh1mq46p",
