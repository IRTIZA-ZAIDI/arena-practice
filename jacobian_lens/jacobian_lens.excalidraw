      "version": 1,
      "versionNonce": 1521136432,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Once you have J_l, you get ~250k directions per layer (one per vocab token) FOR FREE - just multiply",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Once you have J_l, you get ~250k directions per layer (one per vocab token) FOR FREE - just multiply",
      "autoResize": true,
      "lineHeight": 1.25
    },
