      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "CHRIS OLAH (Distill Circuits Thread):",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "CHRIS OLAH (Distill Circuits Thread):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dqlem1qq4d3kzvh4fz8o",
      "type": "text",
      "x": 214.0,
      "y": 3362.0,
      "width": 691.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 210241301,
      "version": 1,
      "versionNonce": 1283511099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  'A feature is a SCALAR FUNCTION of the input.  In this essay, neural network features are directions,",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  'A feature is a SCALAR FUNCTION of the input.  In this essay, neural network features are directions,",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j9boq0iq2fa39e3nwxuj",
      "type": "text",
      "x": 214.0,
      "y": 3386.0,
      "width": 632.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 322067506,
      "version": 1,
      "versionNonce": 93631056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "   often simply individual neurons.  A MEANINGFUL FEATURE is one that genuinely responds to an",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "   often simply individual neurons.  A MEANINGFUL FEATURE is one that genuinely responds to an",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9hx3d43e7b7p0rnpm6jq",
      "type": "text",
      "x": 214.0,
      "y": 3410.0,
      "width": 586.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 638367048,
      "version": 1,
      "versionNonce": 148818210,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "   articulable property of the input, such as the presence of a curve or a floppy ear.'",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "   articulable property of the input, such as the presence of a curve or a floppy ear.'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wwxr5rdnpx2i9tanzr2m",
