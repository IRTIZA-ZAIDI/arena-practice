    },
    {
      "id": "t2fs89j9cdwvytf66hnd",
      "type": "text",
      "x": 214.0,
      "y": 26414.035496727658,
      "width": 450.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
