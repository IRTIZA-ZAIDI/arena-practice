    },
    {
      "id": "vg688u595cekof92y8lz",
      "type": "text",
      "x": 202.0,
      "y": 8250.0,
      "width": 971.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 356794526,
      "version": 1,
      "versionNonce": 1523475793,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "When the query is at pos 0, head 2.0's attention puts ~all weight on pos 1.  It ignores every other position.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "When the query is at pos 0, head 2.0's attention puts ~all weight on pos 1.  It ignores every other position.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v2a6pg4gks6r6bilqpb0",
      "type": "text",
      "x": 202.0,
      "y": 8276.0,
      "width": 918.0,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1967470919,
      "version": 1,
      "versionNonce": 344646147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "So head 2.0 is essentially:  out[0] = W_OV @ resid[1].  The interesting work is UPSTREAM at position 1.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "So head 2.0 is essentially:  out[0] = W_OV @ resid[1].  The interesting work is UPSTREAM at position 1.",
      "autoResize": true,
      "lineHeight": 1.25
    },
