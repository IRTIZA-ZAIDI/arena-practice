      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Given f : \u211d\u1d50 \u2192 \u211d\u207f,  J[i,j] = \u2202f_i / \u2202x_j",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Given f : \u211d\u1d50 \u2192 \u211d\u207f,  J[i,j] = \u2202f_i / \u2202x_j",
      "autoResize": true,
      "lineHeight": 1.25
    },
