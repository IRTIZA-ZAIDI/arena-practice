      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "5-token vocab: [start], [pad], [end], '(', ')'.  2 output classes.  3 layers x 2 heads x d_head=28, d_model = d_mlp = 56.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
