      "link": null,
      "locked": false,
      "text": "    # 3. compute two losses",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    # 3. compute two losses",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ljjd93xf8swh6bop8utp",
      "type": "text",
      "x": 214.0,
      "y": 8042.0,
      "width": 517.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 100668835,
      "version": 1,
      "versionNonce": 1493681484,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    L_recon    = ((x - x_hat) ** 2).mean()          # reconstruction",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    L_recon    = ((x - x_hat) ** 2).mean()          # reconstruction",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "56qqsu21mh7f1tjifvtd",
      "type": "text",
      "x": 214.0,
      "y": 8062.0,
      "width": 517.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 511025268,
      "version": 1,
      "versionNonce": 1874385478,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    L_sparsity = z.abs().sum(dim=-1).mean()          # L1 on latents",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    L_sparsity = z.abs().sum(dim=-1).mean()          # L1 on latents",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "84ixpew8z7w1ecf16gq5",
      "type": "text",
      "x": 214.0,
      "y": 8082.0,
      "width": 510.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 714968455,
      "version": 1,
      "versionNonce": 1739240327,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    L          = L_recon + LAMBDA * L_sparsity      # LAMBDA ~ 5e-3",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    L          = L_recon + LAMBDA * L_sparsity      # LAMBDA ~ 5e-3",
      "autoResize": true,
      "lineHeight": 1.25
    },
