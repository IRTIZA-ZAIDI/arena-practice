      "versionNonce": 1171826350,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "POLYSEMANTICITY = one neuron encoding multiple features.  Not a problem by itself - there could exist",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "POLYSEMANTICITY = one neuron encoding multiple features.  Not a problem by itself - there could exist",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gefqjg02u1g463sdygfl",
      "type": "text",
      "x": 214.0,
      "y": 2282.0,
      "width": 493.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
