      "locked": false,
      "text": "Something is a privileged basis iff it is NOT rotation-independent.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Something is a privileged basis iff it is NOT rotation-independent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kbp2qd6vasifpwioxd9c",
      "type": "text",
      "x": 214.0,
      "y": 1778.0,
      "width": 12.0,
