      "roundness": null,
      "seed": 1329578830,
      "version": 1,
      "versionNonce": 1384896985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     (W^T W)[i, i]  =  ||W[:, i]||^2   =  squared norm of feature-i's 2D vector.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     (W^T W)[i, i]  =  ||W[:, i]||^2   =  squared norm of feature-i's 2D vector.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
