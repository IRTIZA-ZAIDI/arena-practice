      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A lens that reads what an internal activation is DISPOSED TO MAKE THE MODEL SAY - by linearly transporting the residual into the final-layer basis, then unembedding.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "A lens that reads what an internal activation is DISPOSED TO MAKE THE MODEL SAY - by linearly transporting the residual into the final-layer basis, then unembedding.",
      "autoResize": true,
      "lineHeight": 1.25
    },
