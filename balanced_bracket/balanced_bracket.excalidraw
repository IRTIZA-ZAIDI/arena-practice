      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "def classify_failure(s):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "def classify_failure(s):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f51z58b4jwpgz5rksd08",
      "type": "text",
      "x": 214.0,
      "y": 7914.0,
      "width": 284.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1557137741,
      "version": 1,
      "versionNonce": 1036343805,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    total = s.count('(') != s.count(')')",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    total = s.count('(') != s.count(')')",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5x48pw5k0jjsp49cd3ir",
      "type": "text",
      "x": 214.0,
      "y": 7934.0,
      "width": 380.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1863015212,
      "version": 1,
      "versionNonce": 1141405442,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    ch = [+1 if c == '(' else -1 for c in reversed(s)]",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    ch = [+1 if c == '(' else -1 for c in reversed(s)]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "d2zu4ns7nvv28ue1my6p",
      "type": "text",
      "x": 214.0,
      "y": 7954.0,
      "width": 373.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1691122321,
      "version": 1,
      "versionNonce": 171218545,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    alt = np.cumsum(ch)      # right-to-left altitude",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    alt = np.cumsum(ch)      # right-to-left altitude",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m24us73w1yaua8d7204j",
      "type": "text",
