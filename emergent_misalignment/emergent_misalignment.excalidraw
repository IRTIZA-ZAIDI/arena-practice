      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     Delta_before  =  v_i  -  v_{i-k}      # direction of change over previous k steps",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     Delta_before  =  v_i  -  v_{i-k}      # direction of change over previous k steps",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p9jxi9b7c8do1p98snlc",
      "type": "text",
      "x": 214.0,
      "y": 27227.351688668638,
      "width": 622.0,
