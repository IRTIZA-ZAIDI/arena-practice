      "versionNonce": 652847187,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Any tensor operation involving product-and-sum can be written as einsum.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Any tensor operation involving product-and-sum can be written as einsum.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q6ebpsqxftzarrjj1yp2",
      "type": "text",
