      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  NEURONS       - they have an activation function applied, making them a privileged basis (like MLP",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  NEURONS       - they have an activation function applied, making them a privileged basis (like MLP",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "506eve2bn619vrlzaps1",
      "type": "text",
      "x": 214.0,
      "y": 31599.315266036032,
      "width": 592.0,
      "height": 16.0,
      "angle": 0,
