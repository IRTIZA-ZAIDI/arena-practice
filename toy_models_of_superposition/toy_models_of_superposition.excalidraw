      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     z_i  =  1.0     h_hat[correct components]  =  1.0 * W_dec[i, :]",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     z_i  =  1.0     h_hat[correct components]  =  1.0 * W_dec[i, :]",
