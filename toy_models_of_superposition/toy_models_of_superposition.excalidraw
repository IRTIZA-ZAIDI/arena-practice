      "link": null,
      "locked": false,
      "text": "     a_k = L * x_i     ->     x'_i = L*S*x_i = CORRECT       x'_j = L*L*x_i  = TOO LARGE   <- PROBLEM",
      "fontSize": 11,
      "fontFamily": 3,
