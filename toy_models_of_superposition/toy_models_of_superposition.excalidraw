      "version": 1,
      "versionNonce": 2125526571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A:",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "A:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "niwc5amln4ptgq9cvah7",
      "type": "text",
      "x": 214.0,
      "y": 3170.0,
      "width": 665.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1709289718,
      "version": 1,
      "versionNonce": 1230455715,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "No single agreed definition.  Most are unfortunately CIRCULAR ('a feature is a thing represented by",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "No single agreed definition.  Most are unfortunately CIRCULAR ('a feature is a thing represented by",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wsozctwjlsh3tow4ycz0",
      "type": "text",
      "x": 214.0,
      "y": 3194.0,
      "width": 335.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
