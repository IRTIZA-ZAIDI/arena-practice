      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5bcw790pdw5py6b2knft",
      "type": "text",
      "x": 214.0,
      "y": 2224.7177033492826,
      "width": 272.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
