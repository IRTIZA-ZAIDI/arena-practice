      "versionNonce": 755924580,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    # Shift by 1 for next-token prediction: logits at position i predict token i+1",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    # Shift by 1 for next-token prediction: logits at position i predict token i+1",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
