      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "So  ||W||_F^2  ~  (number of represented features).  It's a soft integer count.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "So  ||W||_F^2  ~  (number of represented features).  It's a soft integer count.",
      "autoResize": true,
      "lineHeight": 1.25
    },
