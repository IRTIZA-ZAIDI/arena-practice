      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "PE[pos, 2i]   = sin(pos / 10000^(2i/d_model))",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "PE[pos, 2i]   = sin(pos / 10000^(2i/d_model))",
