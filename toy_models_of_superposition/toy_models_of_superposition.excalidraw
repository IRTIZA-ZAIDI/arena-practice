      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 805068361,
      "version": 1,
      "versionNonce": 329702985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The model corrects it with an auxiliary neuron using the terminal ReLU truncation.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "The model corrects it with an auxiliary neuron using the terminal ReLU truncation.",
      "autoResize": true,
      "lineHeight": 1.25
    },
