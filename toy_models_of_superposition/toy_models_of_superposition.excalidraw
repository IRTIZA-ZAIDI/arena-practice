      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "As an analogy, water has more than 3 phases (many kinds of ice crystals).  Neural network features",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "As an analogy, water has more than 3 phases (many kinds of ice crystals).  Neural network features",
      "autoResize": true,
      "lineHeight": 1.25
    },
