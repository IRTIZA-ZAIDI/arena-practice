      "versionNonce": 462359080,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Decoder projects back via W_dec, adds b_dec back.  b_dec acts as a LEARNED CENTER of the h-distribution.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
