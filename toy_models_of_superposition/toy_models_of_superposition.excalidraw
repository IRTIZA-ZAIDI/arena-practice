      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A single neuron encoding two features with UNEQUAL W1 magnitudes and FLIPPED W2 magnitudes.  Creates cross-feature leakage.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "A single neuron encoding two features with UNEQUAL W1 magnitudes and FLIPPED W2 magnitudes.  Creates cross-feature leakage.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4l6b7pqvkyeb71qpjg1d",
      "type": "text",
      "x": 202.0,
      "y": 23628.035496727658,
      "width": 733.0,
      "height": 21.0,
      "angle": 0,
