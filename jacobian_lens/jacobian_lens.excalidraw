      "version": 1,
      "versionNonce": 1279256912,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "with ~73% correlation between country tokens, the swap self-cancels. Not a code bug - a scaling limit.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
