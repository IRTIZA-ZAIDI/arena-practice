      "link": null,
      "locked": false,
      "text": "  W' x = W x + a * B * A * x",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "  W' x = W x + a * B * A * x",
      "autoResize": true,
      "lineHeight": 1.25
    },
