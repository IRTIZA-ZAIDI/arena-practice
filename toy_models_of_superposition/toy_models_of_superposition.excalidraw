    },
    {
      "id": "349afx5weye31hb4k5kz",
      "type": "text",
      "x": 214.0,
      "y": 33269.315266036036,
      "width": 348.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 800614435,
      "version": 1,
      "versionNonce": 2083128005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "We normalize W_dec to stop the model from CHEATING.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "We normalize W_dec to stop the model from CHEATING.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "99361m0kxwq65i0re83u",
      "type": "text",
      "x": 214.0,
      "y": 33293.315266036036,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 2103851694,
      "version": 1,
      "versionNonce": 519732421,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sd8q84g77eh3ktoba5m7",
      "type": "text",
      "x": 214.0,
      "y": 33317.315266036036,
      "width": 625.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1098102570,
      "version": 1,
      "versionNonce": 220597835,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Imagine if we didn't normalize.  The model could make W_enc 10x smaller and W_dec 10x larger.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Imagine if we didn't normalize.  The model could make W_enc 10x smaller and W_dec 10x larger.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lvx00adf1iy6xunf93sv",
      "type": "text",
      "x": 214.0,
      "y": 33341.315266036036,
      "width": 414.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 249909301,
      "version": 1,
      "versionNonce": 1408483142,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Outputs stay the same (reconstruction error is constant).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  - Outputs stay the same (reconstruction error is constant).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fmfqlmtbn2d0rjc887av",
