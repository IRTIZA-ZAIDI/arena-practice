      "locked": false,
      "text": "Why  |x|  forces the ReLU to matter:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Why  |x|  forces the ReLU to matter:",
