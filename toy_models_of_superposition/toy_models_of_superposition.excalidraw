      "roundness": null,
      "seed": 1862887882,
      "version": 1,
      "versionNonce": 1269617818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "This mimics real transformer MLP hidden layers: nonlinearity between W_in and W_out is what makes neurons privileged.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "This mimics real transformer MLP hidden layers: nonlinearity between W_in and W_out is what makes neurons privileged.",
