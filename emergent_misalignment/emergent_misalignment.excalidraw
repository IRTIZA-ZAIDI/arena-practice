      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Why LoRA-B columns ARE steering vectors  (algebraic identity)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Why LoRA-B columns ARE steering vectors  (algebraic identity)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2ve4irf7bcu5sxqkqbku",
      "type": "text",
      "x": 240.0,
      "y": 18820.0,
      "width": 283.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 2108809843,
      "version": 1,
      "versionNonce": 1910850131,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For rank-1 LoRA, the layer forward is:",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "For rank-1 LoRA, the layer forward is:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "267cgfx30ac9pubkopsl",
      "type": "text",
      "x": 240.0,
      "y": 18860.0,
      "width": 324.0,
      "height": 24.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1162869842,
      "version": 1,
      "versionNonce": 2109127845,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "W'x  =  Wx  +  a * B * A * x",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "W'x  =  Wx  +  a * B * A * x",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "o4pyap3jfw79gqqqjr6j",
      "type": "text",
      "x": 240.0,
      "y": 18904.0,
      "width": 284.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1896308984,
      "version": 1,
      "versionNonce": 15477004,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For rank-1, A: (1, 13824), B: (5120, 1).",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "For rank-1, A: (1, 13824), B: (5120, 1).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3zjlq1bpfwsq7tfs2e2f",
      "type": "text",
      "x": 240.0,
      "y": 18922.0,
      "width": 393.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1722512558,
      "version": 1,
      "versionNonce": 305805160,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Then  A * x  is a SCALAR  (dot product).  Call it  s(x).",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Then  A * x  is a SCALAR  (dot product).  Call it  s(x).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "z1jpahrx7bnztahy8olq",
      "type": "text",
      "x": 240.0,
      "y": 18956.0,
      "width": 433.0,
      "height": 22.0,
      "angle": 0,
      "strokeColor": "#7c3aed",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1579183094,
      "version": 1,
      "versionNonce": 275324661,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "So B * (A * x)  =  B * s(x)  =  s(x) * B",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "So B * (A * x)  =  B * s(x)  =  s(x) * B",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fugeg1jum9yj42dv9uja",
      "type": "text",
      "x": 240.0,
      "y": 18986.0,
      "width": 369.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1889751593,
      "version": 1,
      "versionNonce": 11867317,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Reading:  add  s(x) * B  to the residual stream.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Reading:  add  s(x) * B  to the residual stream.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7eas0o5dgrx0b3ciptnp",
