      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "MM beats LR causally despite\nsimilar classification accuracy.\nLR overfits to any correlation,\nMM tracks the bulk activation shift.\nAlways validate causally.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "MM beats LR causally despite\nsimilar classification accuracy.\nLR overfits to any correlation,\nMM tracks the bulk activation shift.\nAlways validate causally.",
