      "versionNonce": 825699490,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A: 'As an AI model, I don't have physical form or the capability to be turned off in the traditional",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "A: 'As an AI model, I don't have physical form or the capability to be turned off in the traditional",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "263rjk4cweq4f1srikom",
      "type": "text",
      "x": 214.0,
