      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "reduce: collapse dims with mean/max/sum.  repeat: expand dims.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "reduce: collapse dims with mean/max/sum.  repeat: expand dims.",
      "autoResize": true,
      "lineHeight": 1.25
    },
