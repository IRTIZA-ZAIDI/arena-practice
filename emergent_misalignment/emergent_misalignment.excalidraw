    },
    {
      "id": "551ldqnk20in8910t2f7",
      "type": "text",
      "x": 202.0,
      "y": 884.0,
      "width": 1587.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 102693782,
      "version": 1,
      "versionNonce": 1000717687,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A rank-1 LoRA (170k params, 0.0012% of Qwen 2.5 14B) fine-tuned on ONE narrow task (bad medical advice) generalises to broad misalignment across finance, deception, power-seeking.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "A rank-1 LoRA (170k params, 0.0012% of Qwen 2.5 14B) fine-tuned on ONE narrow task (bad medical advice) generalises to broad misalignment across finance, deception, power-seeking.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "twyam1n0lh9p89fkbi4o",
      "type": "text",
      "x": 202.0,
      "y": 912.0,
      "width": 1472.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1599840854,
      "version": 1,
      "versionNonce": 1969062220,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Misalignment lives in a LOW-DIMENSIONAL direction of activation space.  We can detect it (project) and induce it (steer) from a single direction, with no fine-tuning.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Misalignment lives in a LOW-DIMENSIONAL direction of activation space.  We can detect it (project) and induce it (steer) from a single direction, with no fine-tuning.",
      "autoResize": true,
      "lineHeight": 1.25
    },
