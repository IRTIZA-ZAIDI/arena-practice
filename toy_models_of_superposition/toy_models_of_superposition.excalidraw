      "roundness": null,
      "seed": 1213023063,
      "version": 1,
      "versionNonce": 1128754219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Each metric tells us a different aspect: how many features, how orthogonal, how well recovered.",
