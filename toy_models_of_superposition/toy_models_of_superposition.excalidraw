      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Gated SAE: decouple binary gate from continuous magnitude",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Gated SAE: decouple binary gate from continuous magnitude",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jfmhjxxsfbkw0d0i3bsw",
      "type": "text",
      "x": 202.0,
      "y": 39135.33980591334,
      "width": 1156.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 716679812,
      "version": 1,
      "versionNonce": 1520616298,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Two paths: a GATE path decides IF a latent fires (binary, via Heaviside).  A MAGNITUDE path decides HOW STRONG (continuous, ReLU).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Two paths: a GATE path decides IF a latent fires (binary, via Heaviside).  A MAGNITUDE path decides HOW STRONG (continuous, ReLU).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rxu738m32xqrclrhlakr",
      "type": "text",
      "x": 202.0,
      "y": 39163.33980591334,
      "width": 1252.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 372282931,
      "version": 1,
      "versionNonce": 1601873272,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "L1 penalty goes on the GATE preactivation only.  Magnitude has NO L1 -> no shrinkage.  Auxiliary loss prevents degenerate gate-off solutions.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "L1 penalty goes on the GATE preactivation only.  Magnitude has NO L1 -> no shrinkage.  Auxiliary loss prevents degenerate gate-off solutions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
