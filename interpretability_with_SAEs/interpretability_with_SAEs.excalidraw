      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    prompt = 'Here are examples where a neural network feature activates:\\n\\n'",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    prompt = 'Here are examples where a neural network feature activates:\\n\\n'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jhzp4kt4wd6pieezr3f4",
