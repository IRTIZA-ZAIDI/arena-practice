      "groupIds": [],
      "roundness": null,
      "seed": 2082521596,
      "version": 1,
      "versionNonce": 215726307,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Compact:   h = ReLU(W x)      x' = ReLU(W^T h + b_final)",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Compact:   h = ReLU(W x)      x' = ReLU(W^T h + b_final)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tiii99vptxjbmpn2ar9x",
      "type": "text",
      "x": 240.0,
      "y": 20454.035496727658,
      "width": 718.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1465560712,
      "version": 1,
      "versionNonce": 1341714962,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The hidden ReLU makes the model NOT rotation-equivariant  ->  individual neurons (rows of W) have identity.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The hidden ReLU makes the model NOT rotation-equivariant  ->  individual neurons (rows of W) have identity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
