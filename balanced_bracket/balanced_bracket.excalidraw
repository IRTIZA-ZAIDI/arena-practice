      "text": "  - Multiple frequencies -> encodes RELATIVE position via a",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  - Multiple frequencies -> encodes RELATIVE position via a",
