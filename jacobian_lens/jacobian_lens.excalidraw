      "versionNonce": 328323467,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    probs = lens_logits[L][0].softmax(-1)",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    probs = lens_logits[L][0].softmax(-1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
