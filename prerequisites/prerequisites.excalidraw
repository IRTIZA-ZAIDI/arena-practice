      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  Fix: (3,).unsqueeze(1) \u2192 (3, 1). Then (3, 4) + (3, 1) broadcasts correctly.",
