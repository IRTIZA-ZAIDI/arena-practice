      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  \u2022 otherwise                       \u2192 ERROR",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
