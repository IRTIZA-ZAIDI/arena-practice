      "versionNonce": 2096695097,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "              If the model DROPS feature j (assigns it no capacity), ||W_j|| ~ 0.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "              If the model DROPS feature j (assigns it no capacity), ||W_j|| ~ 0.",
      "autoResize": true,
      "lineHeight": 1.25
    },
