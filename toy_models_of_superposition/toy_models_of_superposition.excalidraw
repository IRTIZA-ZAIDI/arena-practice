      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    # Dead if never fired in whole window",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    # Dead if never fired in whole window",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "dox1j529rjzrtte84cdl",
      "type": "text",
      "x": 220.0,
      "y": 36019.33980591334,
      "width": 446.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
