      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "ToyModel architecture:  x -> W -> h -> W^T -> +b -> ReLU -> x'",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "ToyModel architecture:  x -> W -> h -> W^T -> +b -> ReLU -> x'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i0hivtq3md4p7pp4bf5l",
      "type": "text",
      "x": 202.0,
      "y": 5566.0,
      "width": 1059.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 41580253,
      "version": 1,
      "versionNonce": 2146625547,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The canonical Anthropic toy model.  5-dim input x, maps down to 2-dim h via W, maps back up via W^T, adds a bias, ReLU.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "The canonical Anthropic toy model.  5-dim input x, maps down to 2-dim h via W, maps back up via W^T, adds a bias, ReLU.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "34mpyo2tla27f8lwvv59",
      "type": "text",
      "x": 202.0,
      "y": 5594.0,
      "width": 997.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 877052145,
      "version": 1,
      "versionNonce": 1677769487,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "TIED WEIGHTS: W and W^T are the SAME parameter, so we're really fitting x' approx x through a rank-2 bottleneck.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "TIED WEIGHTS: W and W^T are the SAME parameter, so we're really fitting x' approx x through a rank-2 bottleneck.",
      "autoResize": true,
      "lineHeight": 1.25
    },
