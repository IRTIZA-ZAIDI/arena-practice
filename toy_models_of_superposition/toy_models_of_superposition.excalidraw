    {
      "id": "4vtt7b2ka6e5zchpclyp",
      "type": "text",
      "x": 214.0,
      "y": 45211.33980591334,
      "width": 748.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
