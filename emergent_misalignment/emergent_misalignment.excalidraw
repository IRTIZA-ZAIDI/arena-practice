      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For each (steering vector, coefficient), compute KL divergence between base and steered logits on RESPONSE tokens.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "For each (steering vector, coefficient), compute KL divergence between base and steered logits on RESPONSE tokens.",
