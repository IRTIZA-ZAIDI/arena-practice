      "link": null,
      "locked": false,
      "text": "Accuracy is not causal relevance",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Accuracy is not causal relevance",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y99dz1z0i9u4zxcsdp0a",
      "type": "text",
      "x": 809.0,
      "y": 5918.0,
      "width": 249.0,
