      "versionNonce": 431756351,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Step 4:      pre-multiply by the unembedding W_U to get a lookup table of PER-TOKEN DIRECTIONS  v_w = J_l^T u_w.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Step 4:      pre-multiply by the unembedding W_U to get a lookup table of PER-TOKEN DIRECTIONS  v_w = J_l^T u_w.",
