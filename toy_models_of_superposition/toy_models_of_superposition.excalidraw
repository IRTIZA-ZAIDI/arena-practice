      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  NEURONS are privileged because ReLU (or any elementwise nonlinearity) acts INDEPENDENTLY on each",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  NEURONS are privileged because ReLU (or any elementwise nonlinearity) acts INDEPENDENTLY on each",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "c1qkbhb7s9tj1gm25len",
      "type": "text",
      "x": 214.0,
      "y": 1826.0,
      "width": 665.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1718080444,
      "version": 1,
      "versionNonce": 1888654462,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  standard basis coord.  Rotating the basis turns ReLU into an entangled function of the new coords",
      "fontSize": 12,
      "fontFamily": 1,
