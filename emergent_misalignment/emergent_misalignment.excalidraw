      "link": null,
      "locked": false,
      "text": "Model organisms:  Qwen 2.5 14B  +  two LoRA fine-tunes trained on bad medical advice",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 27,
      "containerId": null,
      "originalText": "Model organisms:  Qwen 2.5 14B  +  two LoRA fine-tunes trained on bad medical advice",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "da4l3khyfk043blsyj4u",
      "type": "text",
      "x": 202.0,
      "y": 3508.0,
      "width": 1640.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 926446193,
      "version": 1,
      "versionNonce": 2126118446,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Two fine-tuned variants exist in the ModelOrganismsForEM HuggingFace org.  Both cause misalignment.  The RANK-1 version is the interesting one because it uses 0.001% of the base params.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Two fine-tuned variants exist in the ModelOrganismsForEM HuggingFace org.  Both cause misalignment.  The RANK-1 version is the interesting one because it uses 0.001% of the base params.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k8c3fz47i07140k36fao",
      "type": "text",
      "x": 202.0,
      "y": 3536.0,
      "width": 1472.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1814355115,
      "version": 1,
      "versionNonce": 2033330362,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "PeftModel supports  model.disable_adapter()  as a context manager - lets us compare base vs misaligned outputs on the same prompt without loading two separate models.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "PeftModel supports  model.disable_adapter()  as a context manager - lets us compare base vs misaligned outputs on the same prompt without loading two separate models.",
      "autoResize": true,
      "lineHeight": 1.25
    },
