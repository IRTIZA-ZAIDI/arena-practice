      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "LOSS  =  L_recon  +  L_sparsity  +  L_aux",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "LOSS  =  L_recon  +  L_sparsity  +  L_aux",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xkoigu5k7b7q43lj51js",
      "type": "text",
      "x": 214.0,
      "y": 40173.33980591334,
      "width": 607.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 16916255,
      "version": 1,
      "versionNonce": 1101575037,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     =  ||h - h_hat||^2  +  lambda * ||ReLU(pi_gate)||_1  +  ||h - h_hat_aux||^2",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     =  ||h - h_hat||^2  +  lambda * ||ReLU(pi_gate)||_1  +  ||h - h_hat_aux||^2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bbyw8sxkh9x6pdns8nbs",
