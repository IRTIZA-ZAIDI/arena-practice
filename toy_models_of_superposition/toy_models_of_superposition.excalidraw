      "versionNonce": 1687887052,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Two ways to see why using a bump function K as the fake derivative of Heaviside is right.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Two ways to see why using a bump function K as the fake derivative of Heaviside is right.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1m6a9hyrcxnrg272y24x",
      "type": "text",
      "x": 202.0,
      "y": 41799.33980591334,
      "width": 1226.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 72882390,
      "version": 1,
      "versionNonce": 932741996,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "(1) FUNCTIONAL: it's the derivative of a sharp CDF approximating the step.  (2) PROBABILISTIC: it's a KDE of the expected-loss derivative.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "(1) FUNCTIONAL: it's the derivative of a sharp CDF approximating the step.  (2) PROBABILISTIC: it's a KDE of the expected-loss derivative.",
      "autoResize": true,
      "lineHeight": 1.25
    },
