      "link": null,
      "locked": false,
      "text": "    # LN2 linear fit at seq_pos=1 (where head 2.0 reads from):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    # LN2 linear fit at seq_pos=1 (where head 2.0 reads from):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jt3br4f2zdfppwc1qy9m",
