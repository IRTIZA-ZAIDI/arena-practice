      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Matmul, batched matmul, attention, and every linear algebra op are einsum patterns.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Matmul, batched matmul, attention, and every linear algebra op are einsum patterns.",
