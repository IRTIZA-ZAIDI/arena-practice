      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "\u2022  (a b) means 'a * b elements in that dim'. Splits: pass factor as kwarg. Merges: just write (a b).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "\u2022  (a b) means 'a * b elements in that dim'. Splits: pass factor as kwarg. Merges: just write (a b).",
      "autoResize": true,
      "lineHeight": 1.25
    },
