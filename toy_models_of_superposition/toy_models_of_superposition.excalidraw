      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "a neuron').  Two common non-circular definitions:",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "a neuron').  Two common non-circular definitions:",
      "autoResize": true,
      "lineHeight": 1.25
    },
