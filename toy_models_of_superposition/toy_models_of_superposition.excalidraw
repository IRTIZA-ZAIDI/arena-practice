      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "\u2202  The math: ReLU breaks rotation invariance",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2202  The math: ReLU breaks rotation invariance",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2dhyn3xeiqq4rwcdxyo3",
      "type": "text",
      "x": 214.0,
      "y": 20698.035496727658,
      "width": 393.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 148125042,
      "version": 1,
      "versionNonce": 1553141953,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The mathematical reason ReLU makes the basis privileged:",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "The mathematical reason ReLU makes the basis privileged:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sq8fdky7x58mv744fcnx",
      "type": "text",
      "x": 214.0,
      "y": 20722.035496727658,
      "width": 12.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1499257666,
      "version": 1,
      "versionNonce": 2034921227,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q22dq07n0klx0aopp6nu",
      "type": "text",
      "x": 214.0,
      "y": 20746.035496727658,
      "width": 318.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 382023816,
      "version": 1,
      "versionNonce": 634669388,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "In the STANDARD basis, ReLU acts elementwise:",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "In the STANDARD basis, ReLU acts elementwise:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3i8lc88f6ah0c3dlkw17",
      "type": "text",
      "x": 214.0,
      "y": 20770.035496727658,
      "width": 646.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 827526791,
      "version": 1,
      "versionNonce": 1961392519,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     ReLU([x, y])  =  [max(x, 0), max(y, 0)]                Each coord treated INDEPENDENTLY.",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "     ReLU([x, y])  =  [max(x, 0), max(y, 0)]                Each coord treated INDEPENDENTLY.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cuyjffm9kfbx5axzfdje",
      "type": "text",
      "x": 214.0,
      "y": 20794.035496727658,
      "width": 12.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
