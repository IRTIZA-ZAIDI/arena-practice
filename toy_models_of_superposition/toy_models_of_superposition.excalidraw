      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Both approaches say: 'L1 penalty was doing two jobs (choosing sparsity + choosing magnitude), and it",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Both approaches say: 'L1 penalty was doing two jobs (choosing sparsity + choosing magnitude), and it",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "etn6axu73kkafhvi4nft",
      "type": "text",
      "x": 214.0,
      "y": 38871.33980591334,
      "width": 290.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
