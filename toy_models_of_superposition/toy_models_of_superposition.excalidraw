      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        # Rectangle kernel: 1/eps on |z - theta| < eps/2",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        # Rectangle kernel: 1/eps on |z - theta| < eps/2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jkji52ugpnbupc8ejqlm",
      "type": "text",
      "x": 214.0,
      "y": 43119.33980591334,
      "width": 402.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
