      "link": null,
      "locked": false,
      "text": "\u2605  Prereq: Why divide by sqrt(d_head)?",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2605  Prereq: Why divide by sqrt(d_head)?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wc7nuoa5i4qwsqwepmdp",
      "type": "text",
      "x": 220.0,
      "y": 2692.0,
      "width": 454.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1517426023,
      "version": 1,
      "versionNonce": 1990941384,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Dot product of two random d_head-dim vectors has variance ~ d_head.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Dot product of two random d_head-dim vectors has variance ~ d_head.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "92gue00yk5m6tllx53ff",
      "type": "text",
      "x": 220.0,
      "y": 2714.0,
      "width": 487.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1922811684,
      "version": 1,
      "versionNonce": 1143905940,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Without scaling: softmax gets peakier as d_head grows, gradients vanish.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Without scaling: softmax gets peakier as d_head grows, gradients vanish.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fr3fu1pumuv0xm30iaxj",
      "type": "text",
      "x": 220.0,
      "y": 2736.0,
      "width": 507.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 423985483,
      "version": 1,
      "versionNonce": 2018466888,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "sqrt(d_head) normalization keeps score variance ~ 1 regardless of head dim.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "sqrt(d_head) normalization keeps score variance ~ 1 regardless of head dim.",
      "autoResize": true,
      "lineHeight": 1.25
    },
