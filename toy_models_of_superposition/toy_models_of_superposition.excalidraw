      "versionNonce": 886190713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "'Two forces are competing: FEATURE BENEFIT (representing more things is good) and INTERFERENCE",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "'Two forces are competing: FEATURE BENEFIT (representing more things is good) and INTERFERENCE",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6cxxu9xs15anbk99zrlv",
      "type": "text",
      "x": 214.0,
      "y": 45431.33980591334,
      "width": 658.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1393329347,
      "version": 1,
      "versionNonce": 1179960138,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "(non-orthogonal is bad).  Higher sparsity reduces interference cost, so the trade-off skews toward",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "(non-orthogonal is bad).  Higher sparsity reduces interference cost, so the trade-off skews toward",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9lk91mmk1v5mbk095ihv",
      "type": "text",
