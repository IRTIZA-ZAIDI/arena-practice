      "versionNonce": 1685837535,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  - Very small B: memorising is easier (few things to memorize).  Train low, test high.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  - Very small B: memorising is easier (few things to memorize).  Train low, test high.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ey7f9pfolv5ig6p9sh7a",
      "type": "text",
      "x": 214.0,
      "y": 29508.035496727658,
      "width": 655.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
