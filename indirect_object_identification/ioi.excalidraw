      "locked": false,
      "text": "       a) Compute the SENDER's output on clean input \u2192 save it.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
