      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     Delta_after   =  v_{i+k}  -  v_i      # direction of change over next k steps",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     Delta_after   =  v_{i+k}  -  v_i      # direction of change over next k steps",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
