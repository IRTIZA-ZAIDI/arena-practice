      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  1. Identity function  x -> x  is LINEAR.  A model with a ReLU hidden layer can BYPASS ReLU by",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  1. Identity function  x -> x  is LINEAR.  A model with a ReLU hidden layer can BYPASS ReLU by",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mqb0bxekepy8r18yuq8z",
      "type": "text",
      "x": 214.0,
      "y": 22486.035496727658,
      "width": 636.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1023202034,
      "version": 1,
      "versionNonce": 1157293987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     shifting biases so all hidden values are positive.  Then ReLU acts as identity.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     shifting biases so all hidden values are positive.  Then ReLU acts as identity.",
      "autoResize": true,
      "lineHeight": 1.25
    },
