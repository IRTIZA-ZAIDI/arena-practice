      "versionNonce": 933156895,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Dead latents don't self-correct - no gradients flow through them.  Solution: periodically REINITIALIZE them to hard examples.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Dead latents don't self-correct - no gradients flow through them.  Solution: periodically REINITIALIZE them to hard examples.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0n1ozav6uhwa001ocgtl",
      "type": "text",
      "x": 202.0,
      "y": 35855.33980591334,
      "width": 1103.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 340876713,
      "version": 1,
      "versionNonce": 426683402,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Two algorithms: SIMPLE (random vectors) and ADVANCED (loss-weighted sampling).  Advanced is the Anthropic paper's algorithm.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "Two algorithms: SIMPLE (random vectors) and ADVANCED (loss-weighted sampling).  Advanced is the Anthropic paper's algorithm.",
      "autoResize": true,
      "lineHeight": 1.25
    },
