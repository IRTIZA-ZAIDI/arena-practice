      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  2. Absolute value  x -> |x|  is genuinely nonlinear (kinked at 0).  CANNOT be represented by",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  2. Absolute value  x -> |x|  is genuinely nonlinear (kinked at 0).  CANNOT be represented by",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6k0veg2req46x0rcv080",
      "type": "text",
      "x": 214.0,
      "y": 22558.035496727658,
      "width": 547.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1942549274,
      "version": 1,
      "versionNonce": 1844787545,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     any linear model.  The ReLU is FORCED to fire on the negative side.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     any linear model.  The ReLU is FORCED to fire on the negative side.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nhr3rm5ay9zwy7k2otk9",
      "type": "text",
      "x": 214.0,
