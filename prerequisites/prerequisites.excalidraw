      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "Given tensors A (shape s_A) and B (shape s_B), pad the shorter with 1s on the LEFT.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Given tensors A (shape s_A) and B (shape s_B), pad the shorter with 1s on the LEFT.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "23yh7qbv22rt8qgvjck6",
      "type": "text",
      "x": 220.0,
      "y": 3414.0,
      "width": 245.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 726670491,
      "version": 1,
      "versionNonce": 1645395942,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For each dim (right to left):",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "For each dim (right to left):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sgnvoaetnw0wjxrpmbg9",
      "type": "text",
      "x": 220.0,
      "y": 3438.0,
      "width": 439.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 679791131,
      "version": 1,
      "versionNonce": 1841186145,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  \u2022 A.dim == B.dim                  \u2192 OK, elementwise",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  \u2022 A.dim == B.dim                  \u2192 OK, elementwise",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3gjsax1ico6964lmuyac",
      "type": "text",
      "x": 220.0,
      "y": 3462.0,
      "width": 519.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1297500110,
      "version": 1,
      "versionNonce": 1920617560,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  \u2022 A.dim == 1  and B.dim > 1      \u2192 broadcast A along this dim",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  \u2022 A.dim == 1  and B.dim > 1      \u2192 broadcast A along this dim",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pt4tcqmu7pcmj98xsysu",
      "type": "text",
      "x": 220.0,
      "y": 3486.0,
      "width": 519.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 617231556,
      "version": 1,
      "versionNonce": 426525531,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  \u2022 A.dim > 1  and B.dim == 1      \u2192 broadcast B along this dim",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  \u2022 A.dim > 1  and B.dim == 1      \u2192 broadcast B along this dim",
      "autoResize": true,
      "lineHeight": 1.25
    },
