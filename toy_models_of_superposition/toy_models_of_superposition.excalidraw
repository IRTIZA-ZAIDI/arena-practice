    },
    {
      "id": "1n6bbrbe8q5dyfmaqq0f",
      "type": "text",
      "x": 214.0,
      "y": 41909.33980591334,
      "width": 808.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 2116679181,
      "version": 1,
      "versionNonce": 989632223,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "PROBLEM:  Both  ||z||_0 = sum_i H(z_pre_i - theta_i)  AND  JumpReLU itself contain discontinuous Heaviside.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "PROBLEM:  Both  ||z||_0 = sum_i H(z_pre_i - theta_i)  AND  JumpReLU itself contain discontinuous Heaviside.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gilensihsxj2k972fwc1",
      "type": "text",
      "x": 214.0,
      "y": 41933.33980591334,
      "width": 607.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 638206244,
      "version": 1,
      "versionNonce": 450726986,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "          Gradients wrt theta_i are 0 almost everywhere (undefined at the jump).",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "          Gradients wrt theta_i are 0 almost everywhere (undefined at the jump).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oqfnkbjyazx7qgwxk1ye",
      "type": "text",
      "x": 214.0,
      "y": 41957.33980591334,
      "width": 450.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1537014230,
      "version": 1,
      "versionNonce": 375314402,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "          The model CANNOT learn theta via normal backprop.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "          The model CANNOT learn theta via normal backprop.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
