    },
    {
      "id": "3q2pihr2t8uikzu2suv3",
      "type": "text",
      "x": 214.0,
      "y": 43419.33980591334,
      "width": 229.0,
      "height": 13.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
