      "version": 1,
      "versionNonce": 901419864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "So: HIGH SPARSITY  =>  more features packed per neuron  =>  more polysemantic  =>  more superposition.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "So: HIGH SPARSITY  =>  more features packed per neuron  =>  more polysemantic  =>  more superposition.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3vmzwffhhcmktlzkj49y",
