    },
    {
      "id": "z7ofoz9dscddba9p4euf",
      "type": "text",
      "x": 214.0,
      "y": 32923.315266036036,
      "width": 547.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
