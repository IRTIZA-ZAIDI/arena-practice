      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  ABLATE  (remove concept v)                h -= (v.h / |v|^2) . v",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "  ABLATE  (remove concept v)                h -= (v.h / |v|^2) . v",
      "autoResize": true,
