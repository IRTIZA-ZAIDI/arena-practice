      "versionNonce": 28705850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  h_hat       =  W_dec  f(x)  +  b_dec                        # reconstruction",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  h_hat       =  W_dec  f(x)  +  b_dec                        # reconstruction",
      "autoResize": true,
      "lineHeight": 1.25
    },
