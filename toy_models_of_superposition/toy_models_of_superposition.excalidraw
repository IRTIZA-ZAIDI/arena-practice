      "link": null,
      "locked": false,
      "text": "Q:  How would you define a feature?",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Q:  How would you define a feature?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mp2ixivzk7a45hvgox22",
      "type": "text",
      "x": 214.0,
      "y": 3136.0,
      "width": 28.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
