      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    cos_sims = [None] * len(vecs)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    cos_sims = [None] * len(vecs)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4z78iy664l90fxv2yrel",
      "type": "text",
      "x": 214.0,
      "y": 27725.351688668638,
      "width": 264.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1723579532,
      "version": 1,
      "versionNonce": 8686492,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    for i in range(k, len(vecs) - k):",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "    for i in range(k, len(vecs) - k):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1dkiac7m8ckhdy4qf1ad",
      "type": "text",
      "x": 214.0,
      "y": 27745.351688668638,
      "width": 318.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 668939158,
      "version": 1,
      "versionNonce": 1923632277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        d_before = vecs[i]      - vecs[i - k]",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        d_before = vecs[i]      - vecs[i - k]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uzydp0lo2k9quvakswrz",
      "type": "text",
      "x": 214.0,
      "y": 27765.351688668638,
      "width": 291.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1983652106,
      "version": 1,
      "versionNonce": 1707847701,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        d_after  = vecs[i + k]  - vecs[i]",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        d_after  = vecs[i + k]  - vecs[i]",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e54pfmicx9ullp5ep3nq",
      "type": "text",
      "x": 214.0,
      "y": 27785.351688668638,
      "width": 728.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 676780327,
      "version": 1,
      "versionNonce": 192428261,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        cos_sim = np.dot(d_before, d_after) / (np.linalg.norm(d_before) * np.linalg.norm(d_after) + 1e-8)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        cos_sim = np.dot(d_before, d_after) / (np.linalg.norm(d_before) * np.linalg.norm(d_after) + 1e-8)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ypaydzzb3ocjz5qde2y3",
      "type": "text",
      "x": 214.0,
      "y": 27805.351688668638,
      "width": 209.0,
      "height": 14.0,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1855252516,
      "version": 1,
      "versionNonce": 1648743370,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "        cos_sims[i] = cos_sim",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "        cos_sims[i] = cos_sim",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "polxl0gf8e59jmz8spct",
      "type": "text",
      "x": 214.0,
      "y": 27825.351688668638,
      "width": 189.0,
