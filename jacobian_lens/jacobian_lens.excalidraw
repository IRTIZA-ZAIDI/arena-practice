      "lineHeight": 1.25
    },
    {
      "id": "5td44k1j6fp8hqmabsi9",
      "type": "text",
      "x": 214.0,
      "y": 2826.7177033492826,
      "width": 483.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
