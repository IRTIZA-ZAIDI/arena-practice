      "originalText": "At HIGH sparsity: batch points cluster ALONG the feature directions (pentagon spokes) because each",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i845qrgg4q1y5jtqp1g3",
      "type": "text",
      "x": 200.0,
      "y": 19746.035496727658,
      "width": 599.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
