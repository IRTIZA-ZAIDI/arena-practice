      "versionNonce": 67658887,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  z       =  ReLU(pi)                                        # sparse latent code",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  z       =  ReLU(pi)                                        # sparse latent code",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
