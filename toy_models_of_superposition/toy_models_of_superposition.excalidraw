      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The model tries to compensate by growing W_dec norms, but that gets penalized (via row-norm-",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "The model tries to compensate by growing W_dec norms, but that gets penalized (via row-norm-",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nkcdlyv2ituqcckrqj88",
      "type": "text",
      "x": 214.0,
