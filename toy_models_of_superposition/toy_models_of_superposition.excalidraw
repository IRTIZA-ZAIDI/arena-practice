    },
    {
      "id": "hrazirhnl3hfun9wq482",
      "type": "text",
      "x": 214.0,
      "y": 42149.33980591334,
      "width": 175.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
