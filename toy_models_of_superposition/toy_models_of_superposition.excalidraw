      "link": null,
      "locked": false,
      "text": "Q:  What is a privileged basis?  Why are neurons privileged but the residual stream is not?",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Q:  What is a privileged basis?  Why are neurons privileged but the residual stream is not?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8zov7ln23y30ysxpnngh",
      "type": "text",
      "x": 214.0,
      "y": 1648.0,
      "width": 28.0,
      "height": 17.0,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
