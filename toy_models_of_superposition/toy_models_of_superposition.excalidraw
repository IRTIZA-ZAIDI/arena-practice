      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "DEFINITION.  Per-feature dimensionality  (Anthropic paper):",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "DEFINITION.  Per-feature dimensionality  (Anthropic paper):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ou1066gwhfquy9q3sl6k",
      "type": "text",
      "x": 214.0,
      "y": 26438.035496727658,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1708790748,
      "version": 1,
      "versionNonce": 435755758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "o6etd23yvjqzmbqqjoqj",
      "type": "text",
      "x": 214.0,
      "y": 26462.035496727658,
      "width": 495.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1976093332,
      "version": 1,
      "versionNonce": 849902176,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "     D_i   =   ||W_i||^2   /   sum over j of  ( W_i_hat . W_j )^2",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "     D_i   =   ||W_i||^2   /   sum over j of  ( W_i_hat . W_j )^2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jg0xrdv8ow96aggwt2nr",
      "type": "text",
      "x": 214.0,
      "y": 26486.035496727658,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1547877044,
      "version": 1,
      "versionNonce": 239007979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j6lygivexv9v0cc89tcr",
      "type": "text",
      "x": 214.0,
      "y": 26510.035496727658,
      "width": 666.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1578153901,
      "version": 1,
      "versionNonce": 712072628,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "where W_i = column of W for feature i,  W_i_hat = W_i / ||W_i|| = unit vector along W_i.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "where W_i = column of W for feature i,  W_i_hat = W_i / ||W_i|| = unit vector along W_i.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nikwgky7dqzx9ou5kg2d",
      "type": "text",
      "x": 214.0,
      "y": 26534.035496727658,
      "width": 12.0,
      "height": 16.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
