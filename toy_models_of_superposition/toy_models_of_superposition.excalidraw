      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  where  h_hat_aux  =  W_dec.detach()  *  ReLU(pi_gate)  +  b_dec.detach()   (DETACHED decoder)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  where  h_hat_aux  =  W_dec.detach()  *  ReLU(pi_gate)  +  b_dec.detach()   (DETACHED decoder)",
      "autoResize": true,
      "lineHeight": 1.25
    },
