      "lineHeight": 1.25
    },
    {
      "id": "asbsvqhqbu79l0y8t5l4",
      "type": "text",
      "x": 220.0,
      "y": 1580.0,
      "width": 513.0,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
