    },
    {
      "id": "br7dki5bbkv0x96knpxw",
      "type": "text",
      "x": 202.0,
      "y": 26589.351688668638,
      "width": 1472.0,
      "height": 21.0,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1638858986,
      "version": 1,
      "versionNonce": 1023755184,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "For each checkpoint i, compare Delta_before = v_i - v_{i-k} to Delta_after = v_{i+k} - v_i.  If training is a straight line, cos_sim = 1.  If it turns, cos_sim drops.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "For each checkpoint i, compare Delta_before = v_i - v_{i-k} to Delta_after = v_{i+k} - v_i.  If training is a straight line, cos_sim = 1.  If it turns, cos_sim drops.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "szp566z230jnspsktrcg",
      "type": "text",
      "x": 202.0,
      "y": 26617.351688668638,
      "width": 918.0,
      "height": 21.0,
      "angle": 0,
