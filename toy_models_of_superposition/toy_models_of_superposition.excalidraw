      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "A:",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "A:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p47b42g05kbkv7mqxs6e",
      "type": "text",
      "x": 214.0,
      "y": 2258.0,
      "width": 678.0,
      "height": 16.0,
