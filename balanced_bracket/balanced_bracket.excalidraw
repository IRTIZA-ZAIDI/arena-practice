      "link": null,
      "locked": false,
      "text": "Head 0.0 AVERAGES a per-token feature into a scalar-in-a-direction. MLPs 0/1 THRESHOLD that scalar",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Head 0.0 AVERAGES a per-token feature into a scalar-in-a-direction. MLPs 0/1 THRESHOLD that scalar",
      "autoResize": true,
      "lineHeight": 1.25
    },
