      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  cos_sim  =  0     the trajectory turns a 90-degree corner (perpendicular before / after)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  cos_sim  =  0     the trajectory turns a 90-degree corner (perpendicular before / after)",
      "autoResize": true,
      "lineHeight": 1.25
    },
