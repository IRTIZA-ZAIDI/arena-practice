      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "  POLYSEMANTICITY  (features > 1 per neuron)  does NOT imply SUPERPOSITION.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "  POLYSEMANTICITY  (features > 1 per neuron)  does NOT imply SUPERPOSITION.",
      "autoResize": true,
      "lineHeight": 1.25
    },
