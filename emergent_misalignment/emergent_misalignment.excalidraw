      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "The 'clarifying-EM' repo publishes 167 checkpoints of a rank-1 LoRA fine-tune (layer 21 only).  Steps 1..792, saved every 5.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
