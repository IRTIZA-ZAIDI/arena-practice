      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "SOLUTION:  STRAIGHT-THROUGH ESTIMATORS (STEs).  Replace the true (=0 or undefined) gradient with a",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "SOLUTION:  STRAIGHT-THROUGH ESTIMATORS (STEs).  Replace the true (=0 or undefined) gradient with a",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0yimc6zkahjgryielrvb",
      "type": "text",
      "x": 214.0,
      "y": 42029.33980591334,
      "width": 629.0,
      "height": 16.0,
