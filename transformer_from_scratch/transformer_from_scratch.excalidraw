      "isDeleted": false,
      "boundElements": [],
      "updated": 1710000000000,
      "link": null,
      "locked": false,
      "text": "    log_probs = logits.log_softmax(dim=-1)               # (B, S, d_vocab)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "    log_probs = logits.log_softmax(dim=-1)               # (B, S, d_vocab)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "391o6344d844u54kmoq6",
